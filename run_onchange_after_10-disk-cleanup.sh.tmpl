{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# after 단계: 새 머신에서도 바이너리와 plist가 배포된 뒤 등록한다.
# script hash: {{ include "private_dot_local/bin/executable_disk-cleanup" | sha256sum }}
# plist hash: {{ include "private_Library/private_LaunchAgents/com.owen.disk-cleanup.plist.tmpl" | sha256sum }}
# config hash: {{ include "dot_config/disk-cleanup/config.json" | sha256sum }}
set -euo pipefail

LABEL=com.owen.disk-cleanup
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
PROFILE="$HOME/.hermes/profiles/cs"
if [[ ! -f "$PROFILE/.env" || ! -f "$PROFILE/scripts/slack_post.py" ]]; then
    # 2026-10-20: 맥북은 이 분기로 새 등록을 건너뛰어, 그 전에 등록된 옛 에이전트(매일 --apply · 캡컷 캐시 전체)가 계속 돌며
    # 효과 패키지 120개를 비웠다. 알림을 못 보내는 맥에선 미리보기도 쓸모가 없으니 이미 등록된 것도 내린다.
    /bin/launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
    /bin/launchctl disable "gui/$(id -u)/$LABEL" 2>/dev/null || true
    echo "disk-cleanup: Hermes CS Slack 설정이 없어 자동 등록을 건너뜀(이미 등록된 것은 내림)"
    exit 0
fi
[[ -x "$HOME/.local/bin/disk-cleanup" && -f "$PLIST" ]]
/usr/bin/plutil -lint "$PLIST"
/bin/launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
/bin/launchctl enable "gui/$(id -u)/$LABEL"
/bin/launchctl bootstrap "gui/$(id -u)" "$PLIST"
echo "disk-cleanup: 매달 1일 10:00(현지 시각) 미리보기만 launchd 등록(삭제는 수동 --apply), 결과는 Slack #ops"
{{ end -}}
