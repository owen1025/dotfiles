{{ if eq .chezmoi.os "darwin" -}}
# 2026-09-23 Owen 지시: github.com:22 가 타임아웃 → 443(ssh.github.com)으로 우회.
# 되돌리기 = 이 블록 삭제.
Host github.com
    HostName ssh.github.com
    Port 443
    User git

# 2026-10-20 Owen: 구 태국 맥미니 = m4 (M4 맥미니, 한국 사무실). 옛 이름 studio-th·oldmac 도 같은 곳으로.
# tailnet IP 로 고정 — MagicDNS 이름이 바뀌거나 m4 의 관리 서버 연결이 끊겨도 그대로 닿는다.
Host m4 studio-th oldmac
    HostName 100.78.251.64
    User owen

{{ end -}}
Host *
{{ if eq .chezmoi.os "darwin" -}}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
