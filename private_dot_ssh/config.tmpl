{{ if eq .chezmoi.os "darwin" -}}
# 2026-09-23 Owen 지시: github.com:22 가 타임아웃 → 443(ssh.github.com)으로 우회.
# 되돌리기 = 이 블록 삭제.
Host github.com
    HostName ssh.github.com
    Port 443
    User git

# 2026-10-20 Owen: 구 태국 맥미니 = m4 (M4 맥미니, 한국 사무실). 옛 이름 studio-th·oldmac 도 같은 곳으로.
# tailnet IP 로 고정 — MagicDNS 이름이 바뀌거나 m4 의 관리 서버 연결이 끊겨도 그대로 닿는다.
Host m4 studio-th oldmac
    HostName 100.78.251.64
    User owen

{{ if eq .chezmoi.hostname "Owenui-Macmini" -}}
# m4 에서 서버(M6)로 — 2026-10-03 맥 이관 때 m4 에 손으로 넣었던 블록(손으로 둔 블록은 chezmoi apply 가 지운다, 2026-10-20 템플릿으로 옮김).
# HostKeyAlias = m4 known_hosts 에 이 이름으로 저장된 서버 키.
Host studio-kr
    HostName 100.74.65.14
    HostKeyAlias studio-kr

{{ end -}}
{{ end -}}
Host *
{{ if eq .chezmoi.os "darwin" -}}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
