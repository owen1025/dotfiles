{{ if eq .chezmoi.os "darwin" -}}
# 2026-09-23 Owen 지시: github.com:22 가 타임아웃 → 443(ssh.github.com)으로 우회.
# 되돌리기 = 이 블록 삭제.
Host github.com
    HostName ssh.github.com
    Port 443
    User git

# 2026-10-20 Owen: 구 태국 맥미니 = m4 (M4 맥미니, 한국 사무실). 옛 이름 studio-th·oldmac 도 같은 곳으로.
# tailnet IP 로 고정 — MagicDNS 이름이 바뀌거나 m4 의 관리 서버 연결이 끊겨도 그대로 닿는다.
Host m4 studio-th oldmac
    HostName 100.78.251.64
    User owen

# 2026-11-25 Owen: 맥북프로(M6) = mbp — 주력 노트북 · 편집 자동화 손 수정 전용 맥 · 캡컷 병렬 맥 · 촬영 맥.
# tailnet IP 로 고정(11-25 관리자 승인 · tailnet 이름 mbp) — 내부망 주소는 DHCP 라 바뀔 수 있고, 사무실 공유기가 *.local 을
# 공인 주소로 잘못 답해 Bonjour 이름(owen-mbp.local)은 시간 초과였다. 사무실 안에선 Tailscale 이 내부망으로 직결한다.
Host mbp
    HostName 100.90.60.106
    User owen

{{ if has .chezmoi.hostname (list "Owenui-Macmini" "owen-mbp") -}}
# m4·맥북프로에서 서버(M6)로 — 2026-10-03 맥 이관 때 m4 에 손으로 넣었던 블록(손으로 둔 블록은 chezmoi apply 가 지운다, 2026-10-20 템플릿으로 옮김).
# 2026-11-25 맥북프로도 — 촬영 키트 automation_pause.sh 가 studio-kr 로 접속한다.
# HostKeyAlias = m4 known_hosts 에 이 이름으로 저장된 서버 키.
Host studio-kr
    HostName 100.74.65.14
    HostKeyAlias studio-kr

{{ end -}}
{{ if ne .chezmoi.hostname "owen-lolui-Macmini" -}}
# 2026-11-15 Owen: 같은 내부망에서 서버(M6)로 — Tailscale 없이 studio.local(서버가 Bonjour 로 알림, 내부망 IP).
# HostKeyAlias studio-kr = 서버 키를 tailnet 주소와 같은 이름으로 확인(m4 known_hosts 에 이미 있다).
Host studio-lan
    HostName studio.local
    HostKeyAlias studio-kr
    User owen

{{ end -}}
{{ end -}}
Host *
{{ if eq .chezmoi.os "darwin" -}}
    IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- end }}
