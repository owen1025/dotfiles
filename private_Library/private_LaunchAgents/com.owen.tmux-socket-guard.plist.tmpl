<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- tmux 서버 소켓이 /tmp 청소(tmp_cleaner, 3일)에 지워지지 않게 지키고 지워졌으면 되살린다 (~/.local/bin/tmux-socket-guard 주석 참고) -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.owen.tmux-socket-guard</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ .chezmoi.homeDir }}/.local/bin/tmux-socket-guard</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/tmux-socket-guard.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/tmux-socket-guard.log</string>
</dict>
</plist>
