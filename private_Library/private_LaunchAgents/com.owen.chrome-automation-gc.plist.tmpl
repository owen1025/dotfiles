<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 자동화가 버린 Chrome 임시 프로필 정리 (~/.local/bin/chrome-automation-gc 주석 참고) -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.owen.chrome-automation-gc</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>{{ .chezmoi.homeDir }}/.local/bin/chrome-automation-gc</string>
	</array>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/chrome-automation-gc.log</string>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/Library/Logs/chrome-automation-gc.log</string>
</dict>
</plist>
