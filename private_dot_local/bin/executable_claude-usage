#!/usr/bin/env python3
"""claude-usage — Claude Code 다중 계정 + ChatGPT(Codex) 계정 사용량/한도 대시보드.

CLAUDE_CONFIG_DIR 로 분리된 각 계정(`claude`, `claude2`, …)의 세션(5시간) 한도와
주간(7일) 한도를 Anthropic OAuth usage API 에서 읽어 요약한다.

ChatGPT 계정(2026-09-08)은 Codex CLI 가 로그인해 둔 `$CODEX_HOME/auth.json`(기본 `~/.codex`)의
토큰으로 `chatgpt.com/backend-api/wham/usage` 를 읽는다 — Codex CLI `/status` 가 보는 바로 그 창
(플랜에 따라 주간 하나 또는 5시간+주간). 토큰은 읽기만 하고 절대 갱신하지 않는다(갱신은 Codex CLI 의
몫 — refresh 토큰이 회전형이라 여기서 돌리면 CLI 쪽 로그인이 깨진다). 만료(발급 후 10일)면 "토큰 만료"
로 보이고 `codex` 를 한 번 실행하면 살아난다. `CLAUDE_USAGE_CHATGPT=0` 으로 끈다.

크레덴셜은 Claude Code 가 두는 곳에서 그대로 읽는다:
  macOS  → 키체인 `Claude Code-credentials` (기본 계정)
           `Claude Code-credentials-<sha256(CLAUDE_CONFIG_DIR)[:8]>` (보조 계정)
  그 외  → <configdir>/.credentials.json
둘 다 있으면 더 늦게 만료되는(= 가장 최근에 갱신된) 쪽을 쓴다.

셸 시작을 절대 막지 않는 3단 캐시:
  1. 렌더 캐시(render-<style>-<width>.txt) — zsh 가 그냥 cat 한다 (~1ms)
  2. 상태 캐시(state.json)                 — 신선도 판정용
  3. 백그라운드 갱신                        — 낡았으면 detach 해서 조용히 새로 받는다

의존성 없음(파이썬 표준 라이브러리만).
"""
from __future__ import annotations

import argparse
import base64
import concurrent.futures
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.request
from datetime import datetime, timezone

API = "https://api.anthropic.com"
CHATGPT_USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
UA = "claude-usage/1.0 (dotfiles; local shell status)"
HOME = os.path.expanduser("~")
CACHE_DIR = os.environ.get(
    "CLAUDE_USAGE_CACHE",
    os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "claude-usage"),
)
CACHE_FILE = os.path.join(CACHE_DIR, "state.json")
LOCK_FILE = os.path.join(CACHE_DIR, "refresh.lock")
RENDER_RE = re.compile(r"^render-(bars|panel|compact)-(\d+)\.txt$")

TTL = int(os.environ.get("CLAUDE_USAGE_TTL", "300"))                # 캐시 신선도(초)
STALE_MAX = int(os.environ.get("CLAUDE_USAGE_STALE_MAX", "86400"))  # 이보다 낡으면 아예 숨김
TIMEOUT = float(os.environ.get("CLAUDE_USAGE_TIMEOUT", "8"))
COLD_TIMEOUT = float(os.environ.get("CLAUDE_USAGE_COLD_TIMEOUT", "4"))
DEFAULT_STYLE = os.environ.get("CLAUDE_USAGE_STYLE", "bars")

# ─────────────────────────────────────────── 계정 탐색


def discover_accounts() -> list[tuple[str, str]]:
    """[(표시이름, CLAUDE_CONFIG_DIR)] 목록.

    CLAUDE_USAGE_ACCOUNTS="claude:~/.claude,claude2:~/.claude-b,claude3:~/.claude-c" 로 덮어쓸 수 있다.
    지정이 없으면 기본 두 계정 + 추가로 만든 ~/.claude-* 디렉터리(크레덴셜이 있는 것만 — 즉
    로그인 전엔 안 보인다)를 자동으로 찾는다. 한 글자 접미사는 서수로(-c → claude3).
    """
    env = os.environ.get("CLAUDE_USAGE_ACCOUNTS")
    if env:
        out = []
        for chunk in env.split(","):
            chunk = chunk.strip()
            if not chunk:
                continue
            label, _, path = chunk.partition(":")
            out.append((label.strip(), os.path.expanduser(path.strip()) if path.strip()
                        else os.path.join(HOME, ".claude")))
        return out

    accounts = [("claude", os.path.join(HOME, ".claude")), ("claude2", os.path.join(HOME, ".claude-b"))]
    seen = {p for _, p in accounts}
    try:
        names = sorted(os.listdir(HOME))
    except OSError:
        names = []
    for name in names:
        if not name.startswith(".claude-"):
            continue
        path = os.path.join(HOME, name)
        if path in seen or not os.path.isdir(path) or not has_creds(path):
            continue
        suffix = name[len(".claude-"):]
        # ~/.claude-b → claude2, ~/.claude-c → claude3 … (셸 함수 이름과 일치); 그 외는 claude:<suffix>
        label = (f"claude{ord(suffix) - ord('a') + 1}" if len(suffix) == 1 and suffix.isalpha() and suffix.islower()
                 else f"claude:{suffix}")
        accounts.append((label, path))
    return accounts


# ─────────────────────────────────────────── ChatGPT(Codex) 계정


def discover_chatgpt_accounts() -> list[tuple[str, str]]:
    """[(표시이름, CODEX_HOME)] — Codex CLI 가 로그인해 둔 ChatGPT 계정.

    CLAUDE_USAGE_CHATGPT="chatgpt:~/.codex,chatgpt2:~/.codex-b" 로 덮어쓰고, "0"/"off" 면 끈다.
    지정이 없으면 $CODEX_HOME(기본 ~/.codex) 에 로그인 토큰이 있을 때만 한 줄 — 로그인 전엔 안 보인다.
    """
    env = os.environ.get("CLAUDE_USAGE_CHATGPT")
    if env is not None and env.strip().lower() in ("0", "off", "false"):
        return []
    if env and env.strip():
        out = []
        for chunk in env.split(","):
            chunk = chunk.strip()
            if not chunk:
                continue
            label, _, path = chunk.partition(":")
            out.append((label.strip() or "chatgpt",
                        os.path.expanduser(path.strip()) if path.strip() else os.path.join(HOME, ".codex")))
        return out
    home = os.environ.get("CODEX_HOME", "").strip() or os.path.join(HOME, ".codex")
    return [("chatgpt", os.path.expanduser(home))] if _codex_tokens(home) else []


def _codex_tokens(codex_home: str) -> dict | None:
    """Codex CLI 의 auth.json → tokens 블록(access_token 이 있을 때만)."""
    try:
        with open(os.path.join(os.path.expanduser(codex_home), "auth.json")) as fh:
            tokens = json.load(fh).get("tokens")
    except Exception:
        return None
    return tokens if isinstance(tokens, dict) and tokens.get("access_token") else None


def _jwt_claims(token: str) -> dict:
    """서명 검증 없이 JWT payload 만 읽는다(만료·이메일·account id 표시용)."""
    try:
        payload = token.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        claims = json.loads(base64.urlsafe_b64decode(payload))
        return claims if isinstance(claims, dict) else {}
    except Exception:
        return {}


CHATGPT_PLAN = {"free": "Free", "go": "Go", "plus": "Plus", "pro": "Pro", "prolite": "Pro Lite",
                "team": "Team", "business": "Business", "enterprise": "Enterprise", "edu": "Edu"}


def chatgpt_plan_label(plan_type: str | None) -> str:
    key = (plan_type or "").strip().lower()
    return CHATGPT_PLAN.get(key, key.title()) if key else ""


def _window_name(seconds) -> str:
    """limit_window_seconds → 표시 이름. 5시간 창 = 세션, 7일 창 = 주간, 그 외는 길이 그대로."""
    if not isinstance(seconds, (int, float)) or seconds <= 0:
        return "한도"
    if seconds <= 6 * 3600:
        return "세션"
    if abs(seconds - 7 * 86400) <= 3600:
        return "주간"
    days = seconds / 86400
    return f"{int(round(days))}일" if days >= 1 else f"{int(round(seconds / 3600))}시간"


def chatgpt_rows(body: dict) -> list[dict]:
    """wham/usage 응답 → normalize() 와 같은 [{name, group, percent, resets_at, severity}]."""
    rows: list[dict] = []

    def add(prefix: str, rl: dict) -> None:
        blown = bool(rl.get("limit_reached"))
        for key in ("primary_window", "secondary_window"):
            win = rl.get(key)
            if not isinstance(win, dict) or win.get("used_percent") is None:
                continue
            secs = win.get("limit_window_seconds")
            name = _window_name(secs)
            reset = win.get("reset_at")
            resets_at = (datetime.fromtimestamp(reset, tz=timezone.utc).isoformat()
                         if isinstance(reset, (int, float)) and reset > 0 else None)
            rows.append({"name": f"{prefix} {name}".strip(),
                         "group": "session" if isinstance(secs, (int, float)) and secs <= 6 * 3600 else "weekly",
                         "percent": win.get("used_percent"), "resets_at": resets_at,
                         "severity": "rejected" if blown else "normal",
                         "extra": bool(prefix)})                    # 모델별 별도 한도 — 컴팩트 뷰는 메인 창만

    rl = body.get("rate_limit")
    if isinstance(rl, dict):
        add("", rl)
    for extra in body.get("additional_rate_limits") or []:      # 모델별 별도 한도 (예: Codex Spark)
        if isinstance(extra, dict) and isinstance(extra.get("rate_limit"), dict):
            add(str(extra.get("limit_name") or "추가 한도"), extra["rate_limit"])
    return rows


def chatgpt_note(body: dict) -> str | None:
    parts = []
    credits = body.get("credits") or {}
    if credits.get("has_credits"):
        bal = credits.get("balance")
        parts.append("크레딧 무제한" if credits.get("unlimited") else f"크레딧 잔액 ${bal}")
    banked = (body.get("rate_limit_reset_credits") or {}).get("available_count")
    if isinstance(banked, (int, float)) and banked > 0:
        parts.append(f"리셋 크레딧 {int(banked)}개")
    return " · ".join(parts) or None


def fetch_chatgpt_account(label: str, codex_home: str, timeout: float) -> dict:
    rec: dict = {"label": label, "dir": codex_home, "kind": "chatgpt", "login_cmd": "codex login"}
    tokens = _codex_tokens(codex_home)
    if not tokens:
        rec["state"] = "logged_out"
        return rec
    access = str(tokens.get("access_token") or "")
    claims = _jwt_claims(access)
    exp = claims.get("exp") or 0
    rec["token_expires_at"] = exp
    rec["login_cmd"] = "codex"                                   # 만료/실패 시엔 한 번 띄우면 CLI 가 갱신한다
    auth = claims.get("https://api.openai.com/auth") or {}
    prof = claims.get("https://api.openai.com/profile") or {}
    rec["email"] = prof.get("email") or claims.get("email")
    if exp and exp <= time.time():
        rec["state"] = "token_expired"
        return rec
    account_id = str(tokens.get("account_id") or auth.get("chatgpt_account_id") or "").strip()
    headers = {"Authorization": f"Bearer {access}", "Accept": "application/json", "User-Agent": "codex-cli"}
    if account_id:
        headers["ChatGPT-Account-Id"] = account_id
    status, body = _http_get(CHATGPT_USAGE_URL, headers, timeout)
    if status in (401, 403):
        rec["state"] = "token_expired"
        return rec
    if status != 200 or not isinstance(body, dict):
        rec["state"] = "error"
        rec["error"] = f"HTTP {status}" if status else str(body)
        return rec
    rec["state"] = "ok"
    rec["rows"] = chatgpt_rows(body)
    rec["note"] = chatgpt_note(body)
    rec["plan"] = chatgpt_plan_label(body.get("plan_type") or auth.get("chatgpt_plan_type"))
    return rec


# ─────────────────────────────────────────── API


DEFAULT_CONFIG_DIR = os.path.join(HOME, ".claude")
KEYCHAIN_SERVICE = "Claude Code-credentials"


def _keychain_services(config_dir: str) -> list[str]:
    """이 계정의 크레덴셜이 들어 있을 수 있는 macOS 키체인 서비스명 후보.

    Claude Code 는 CLAUDE_CONFIG_DIR 을 바꾼 계정을 `Claude Code-credentials-<절대경로 sha256 앞 8자리>`
    로 구분한다(경로는 환경변수에 준 그대로, 끝 슬래시 없이). 기본 디렉터리(~/.claude)는 접미사가 없다.
    """
    paths = [config_dir]
    if os.path.normpath(config_dir) != config_dir:
        paths.append(os.path.normpath(config_dir))
    out = [f"{KEYCHAIN_SERVICE}-{hashlib.sha256(p.encode()).hexdigest()[:8]}" for p in paths]
    if os.path.realpath(config_dir) == os.path.realpath(DEFAULT_CONFIG_DIR):
        out.insert(0, KEYCHAIN_SERVICE)
    return out


def _oauth_from_keychain(config_dir: str) -> list[dict]:
    if sys.platform != "darwin":
        return []
    found = []
    for svc in _keychain_services(config_dir):
        try:
            proc = subprocess.run(["security", "find-generic-password", "-s", svc, "-w"],
                                  capture_output=True, text=True, timeout=5)
            oauth = json.loads(proc.stdout).get("claudeAiOauth") if proc.returncode == 0 else None
        except Exception:
            oauth = None
        if oauth:
            found.append(oauth)
    return found


def _oauth_from_file(config_dir: str) -> list[dict]:
    try:
        with open(os.path.join(config_dir, ".credentials.json")) as fh:
            oauth = json.load(fh).get("claudeAiOauth")
    except Exception:
        return []
    return [oauth] if oauth else []


def _creds(config_dir: str) -> dict | None:
    """키체인(macOS)과 .credentials.json 중 가장 늦게 만료되는 크레덴셜.

    Claude Code 는 토큰을 갱신할 때 키체인만 새로 쓰므로, 예전 버전이 남긴 파일보다 키체인이 새롭다.
    """
    found = _oauth_from_keychain(config_dir) + _oauth_from_file(config_dir)
    if not found:
        return None
    return max(found, key=lambda o: o.get("expiresAt") or 0)


def has_creds(config_dir: str) -> bool:
    return _creds(config_dir) is not None


def _http_get(url: str, headers: dict, timeout: float) -> tuple[int, object]:
    req = urllib.request.Request(url, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        return exc.code, None
    except Exception as exc:
        return 0, type(exc).__name__


def _get(path: str, token: str, timeout: float) -> tuple[int, object]:
    return _http_get(API + path, {
        "Authorization": f"Bearer {token}",
        "anthropic-beta": "oauth-2025-04-20",
        "Accept": "application/json",
        "User-Agent": UA,
    }, timeout)


def fetch_account(label: str, config_dir: str, timeout: float) -> dict:
    rec: dict = {"label": label, "dir": config_dir, "kind": "claude"}
    oauth = _creds(config_dir)
    if not oauth:
        rec["state"] = "logged_out"
        return rec

    exp = (oauth.get("expiresAt") or 0) / 1000
    rec["token_expires_at"] = exp
    if exp and exp <= time.time():
        rec["state"] = "token_expired"
        return rec

    token = oauth.get("accessToken") or ""
    status, usage = _get("/api/oauth/usage", token, timeout)
    if status in (401, 403):
        rec["state"] = "token_expired"
        return rec
    if status != 200 or not isinstance(usage, dict):
        rec["state"] = "error"
        rec["error"] = f"HTTP {status}" if status else str(usage)
        return rec

    rec["state"] = "ok"
    rec["usage"] = usage
    status, profile = _get("/api/oauth/profile", token, timeout)
    org = {}
    if status == 200 and isinstance(profile, dict):
        rec["email"] = (profile.get("account") or {}).get("email")
        org = profile.get("organization") or {}
    rec["plan"] = plan_label(org, oauth)
    return rec


def plan_label(org: dict, oauth: dict) -> str:
    tier = (org.get("rate_limit_tier") or oauth.get("rateLimitTier") or "").strip()
    if tier.startswith("default_claude_"):
        parts = tier[len("default_claude_"):].split("_")
        return " ".join([parts[0].title()] + parts[1:])   # default_claude_max_20x → "Max 20x"
    sub = (oauth.get("subscriptionType") or org.get("organization_type") or "").replace("claude_", "")
    return sub.title() if sub else ""


# ─────────────────────────────────────────── 한도 정규화

KIND_KO = {"session": "세션", "weekly_all": "주간 전체", "weekly_scoped": "주간"}
LEGACY = (("five_hour", "세션", "session"), ("seven_day", "주간 전체", "weekly"),
          ("seven_day_opus", "주간 Opus", "weekly"), ("seven_day_sonnet", "주간 Sonnet", "weekly"))


def normalize(usage: dict) -> list[dict]:
    """API 응답을 [{name, group, percent, resets_at, severity}] 로 평탄화."""
    rows: list[dict] = []
    limits = usage.get("limits")
    if isinstance(limits, list) and limits:
        for lim in limits:
            kind = lim.get("kind") or ""
            name = KIND_KO.get(kind, kind)
            model = (((lim.get("scope") or {}).get("model") or {}).get("display_name") or "").strip()
            if kind == "weekly_scoped" and model:
                name = f"주간 {model}"
            rows.append({"name": name, "kind": kind, "model": model,
                         "group": lim.get("group") or kind, "percent": lim.get("percent"),
                         "resets_at": lim.get("resets_at"), "severity": lim.get("severity") or "normal"})
        return rows

    for key, name, group in LEGACY:                      # 구버전 응답 폴백
        blk = usage.get(key)
        if isinstance(blk, dict) and blk.get("utilization") is not None:
            kind = "session" if key == "five_hour" else ("weekly_all" if key == "seven_day" else "weekly_scoped")
            rows.append({"name": name, "kind": kind, "model": name.removeprefix("주간 ") if kind == "weekly_scoped" else "",
                         "group": group, "percent": blk.get("utilization"),
                         "resets_at": blk.get("resets_at"), "severity": "normal"})
    return rows


def extra_usage_line(usage: dict) -> str | None:
    """추가 사용량(크레딧)이 켜져 있을 때만 한 줄."""
    extra = usage.get("extra_usage") or {}
    if not extra.get("is_enabled"):
        return None
    used, limit = extra.get("used_credits"), extra.get("monthly_limit")
    util = extra.get("utilization")
    if used is None and util is None:
        return None
    if limit:
        return f"추가 크레딧 {used or 0}/{limit}" + (f" ({int(util)}%)" if util is not None else "")
    return f"추가 크레딧 {used or 0} 사용"


def rows_of(acct: dict) -> list[dict]:
    """계정 종류에 상관없이 렌더러가 쓰는 한도 행. ChatGPT 는 조회 때 이미 평탄화해 둔다."""
    if acct.get("kind") == "chatgpt":
        return list(acct.get("rows") or [])
    return normalize(acct.get("usage") or {})


def limit_warning(acct: dict) -> str | None:
    """로그인 성공과 사용 가능량은 별개. 모델 한도 소진을 계정 전체 소진으로 표시하지 않는다."""
    if acct.get("kind") == "chatgpt" or acct.get("state") != "ok":
        return None
    blocked = [r for r in rows_of(acct) if r["severity"] == "rejected"
               or (r["percent"] is not None and r["percent"] >= 100)]
    global_limits = [r for r in blocked if r["kind"] in ("session", "weekly_all")]
    if global_limits:
        return "⚠ 전체 사용 제한 · " + ", ".join(r["name"] for r in global_limits) + " 소진"
    if blocked:
        return "⚠ " + ", ".join(r["model"] or r["name"] for r in blocked) + " 사용 제한 · 주간 한도 소진"
    return None


def note_of(acct: dict) -> str | None:
    if acct.get("kind") == "chatgpt":
        return acct.get("note")
    return extra_usage_line(acct.get("usage") or {})


def title_of(accounts: list[dict]) -> str:
    return "Claude · ChatGPT 사용량" if any(a.get("kind") == "chatgpt" for a in accounts) else "Claude 사용량"


# ─────────────────────────────────────────── 폭/시간 포맷


def dwidth(text: str) -> int:
    """터미널에서 차지하는 칸 수(한글·이모지 = 2칸)."""
    total = 0
    for ch in text:
        if unicodedata.combining(ch):
            continue
        total += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return total


def pad(text: str, width: int, align: str = "<") -> str:
    gap = max(0, width - dwidth(text))
    if align == ">":
        return " " * gap + text
    return text + " " * gap


def ellipsize(text: str, width: int) -> str:
    if width <= 0:
        return ""
    if dwidth(text) <= width:
        return text
    out = ""
    for ch in text:
        if dwidth(out + ch) > width - 1:
            break
        out += ch
    return out + "…"


def tilde(path: str) -> str:
    return "~" + path[len(HOME):] if path.startswith(HOME) else path


def reset_text(iso: str | None, suffix: str = "") -> str:
    """렌더 캐시를 나중에 읽어도 정확하도록 상대시간 대신 로컬 초기화 시각을 저장한다."""
    if not iso:
        return "초기화 예정 없음" if suffix else "—"
    try:
        return datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone().strftime("%m/%d %H:%M") + suffix
    except (ValueError, TypeError):
        return "—"


def fetched_text(ts: float) -> str:
    return datetime.fromtimestamp(ts).astimezone().strftime("%m/%d %H:%M %Z 조회")


# ─────────────────────────────────────────── 색


class Ink:
    def __init__(self, enabled: bool):
        self.on = enabled

    def _w(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.on else text

    def dim(self, t):    return self._w("2", t)
    def bold(self, t):   return self._w("1", t)
    def green(self, t):  return self._w("38;5;71", t)
    def yellow(self, t): return self._w("38;5;179", t)
    def orange(self, t): return self._w("38;5;173", t)
    def red(self, t):    return self._w("38;5;167", t)
    def blue(self, t):   return self._w("38;5;110", t)
    def track(self, t):  return self._w("38;5;238", t)

    def by_load(self, pct, severity: str, text: str) -> str:
        if severity == "rejected" or (pct is not None and pct >= 100):
            return self.red(text)
        if pct is None:
            return self.dim(text)
        if pct >= 90:
            return self.red(text)
        if pct >= 75:
            return self.orange(text)
        if pct >= 50:
            return self.yellow(text)
        return self.green(text)


def gauge(ink: Ink, pct, width: int, severity: str = "normal") -> str:
    if pct is None:
        return ink.track("░" * width)
    filled = max(0, min(width, int(round(width * min(pct, 100) / 100))))
    if pct > 0 and filled == 0:
        filled = 1                       # 1% 도 눈에 보이게
    return ink.by_load(pct, severity, "█" * filled) + ink.track("░" * (width - filled))


STATE_MSG = {
    "logged_out": ("✗", "미로그인 — `{cmd}` 를 실행해 브라우저 로그인"),
    "token_expired": ("⚠", "토큰 만료 — `{cmd}` 를 한 번 실행하면 갱신됨"),
    "error": ("⚠", "조회 실패 ({err})"),
}


def problem_of(acct: dict) -> tuple[str, str] | None:
    if acct.get("state") == "ok":
        return None
    icon, msg = STATE_MSG.get(acct.get("state"), ("⚠", "알 수 없는 상태"))
    cmd = acct.get("login_cmd") or acct.get("label", "claude")
    return icon, msg.format(cmd=cmd, err=acct.get("error", "?"))


# ─────────────────────────────────────────── 렌더러


def render(state: dict, style: str, ink: Ink, width: int) -> str:
    accounts = state.get("accounts") or []
    if not accounts:
        return ""
    stamp = state.get("fetched_at", time.time())
    if style == "compact":
        return render_compact(accounts, stamp, ink, width)
    if style == "panel":
        return render_panel(accounts, stamp, ink, width)
    return render_bars(accounts, stamp, ink, width)


def render_bars(accounts, stamp, ink, width) -> str:
    terse = width < 84
    bar_w = 24 if width >= 96 else (18 if width >= 84 else (12 if width >= 72 else 8))
    name_w = max((dwidth(r["name"]) for a in accounts if a.get("state") == "ok"
                  for r in rows_of(a)), default=8)
    out = [f" {ink.bold(title_of(accounts))}  {ink.dim('·')}  {ink.dim(fetched_text(stamp))}",
           " " + ink.dim("─" * max(20, min(width - 2, 74)))]
    for i, acct in enumerate(accounts):
        if i:
            out.append("")
        head = f" {ink.bold(ink.blue(pad(acct['label'], 9)))}{ink.dim(acct.get('email') or tilde(acct['dir']))}"
        if acct.get("plan"):
            head += "  " + ink.dim(f"[{acct['plan']}]")
        out.append(head)
        problem = problem_of(acct)
        if problem:
            out.append(f"   {ink.red(problem[0])} {ink.dim(problem[1])}")
            continue
        warning = limit_warning(acct)
        if warning:
            out.append(f"   {ink.red(warning)}")
        for row in rows_of(acct):
            pct, sev = row["percent"], row["severity"]
            used = "  ?" if pct is None else f"{int(pct):>3d}%"
            left = "  —" if pct is None else f"{100 - min(int(pct), 100):>3d}%"
            blown = sev == "rejected" or (pct is not None and pct >= 100)
            if terse:
                mid = f"{ink.by_load(pct, sev, used)} {ink.dim('·')} {ink.bold(left)} {ink.dim('남음')}"
                tail = f"{ink.dim('↻')} {ink.dim(reset_text(row['resets_at']))}"
            else:
                mid = (f"{ink.red('한도 초과')} {ink.dim('·')} 남음 {ink.bold(left)}" if blown
                       else f"{ink.by_load(pct, sev, used)} 사용 {ink.dim('·')} 남음 {ink.bold(left)}")
                tail = f"{ink.dim('·')} {ink.dim(reset_text(row['resets_at'], ' 초기화'))}"
            out.append(f"   {pad(row['name'], name_w)}  {gauge(ink, pct, bar_w, sev)}  {mid} {tail}")
        note = note_of(acct)
        if note:
            out.append(f"   {ink.dim(note)}")
    return "\n".join(out)


def render_panel(accounts, stamp, ink, width) -> str:
    inner = min(max(width - 4, 56), 78)
    title, right = title_of(accounts), fetched_text(stamp)
    fill = max(1, inner - dwidth(title) - dwidth(right) - 4)
    out = [ink.dim("╭─ ") + ink.bold(title) + " " + ink.dim("─" * fill) + " " + ink.dim(right) + ink.dim(" ─╮")]

    def line(body: str, plain: str) -> str:
        return ink.dim("│") + " " + body + " " * max(0, inner - dwidth(plain)) + ink.dim(" │")

    for i, acct in enumerate(accounts):
        if i:
            out.append(ink.dim("├" + "─" * (inner + 2) + "┤"))
        lbl = pad(acct["label"], 9)
        plan = acct.get("plan") or ""
        who = ellipsize(acct.get("email") or tilde(acct["dir"]), max(8, inner - dwidth(lbl) - dwidth(plan) - 1))
        gap = max(1, inner - dwidth(lbl + who) - dwidth(plan))
        out.append(ink.dim("│") + " " + ink.bold(ink.blue(lbl)) + ink.dim(who)
                   + " " * gap + ink.dim(plan) + ink.dim(" │"))

        problem = problem_of(acct)
        if problem:
            icon, msg = problem[0], ellipsize(problem[1], inner - 4)
            out.append(line(f"  {ink.red(icon)} {ink.dim(msg)}", f"  {icon} {msg}"))
            continue

        warning = limit_warning(acct)
        if warning:
            out.append(line(ink.red(warning), warning))
        rows = rows_of(acct)
        name_w = max((dwidth(r["name"]) for r in rows), default=8)
        # 고정 폭: 들여쓰기 2 + 이름 + 2 + 바 + " 100% 남음 100% ↻ " + 리셋(≤10칸) ≈ 이름 + 바 + 24
        bar_w = max(8, inner - name_w - 24)
        for row in rows:
            pct, sev = row["percent"], row["severity"]
            used = "  ?" if pct is None else f"{int(pct):>3d}%"
            left = "  —" if pct is None else f"{100 - min(int(pct), 100):>3d}%"
            reset = reset_text(row["resets_at"])
            plain = f"  {pad(row['name'], name_w)}  {'x' * bar_w} {used} 남음 {left} ↻ {reset}"
            body = (f"  {pad(row['name'], name_w)}  {gauge(ink, pct, bar_w, sev)} "
                    f"{ink.by_load(pct, sev, used)} {ink.dim('남음')} {ink.bold(left)} {ink.dim('↻ ' + reset)}")
            out.append(line(body, plain))
        note = note_of(acct)
        if note:
            out.append(line(f"  {ink.dim(note)}", f"  {note}"))
    out.append(ink.dim("╰" + "─" * (inner + 2) + "╯"))
    return "\n".join(out)


def render_compact(accounts, stamp, ink, width) -> str:
    bar_w = 10 if width >= 100 else (8 if width >= 84 else (6 if width >= 72 else 4))
    clock_w = 11 if width >= 72 else 0
    out = []
    for acct in accounts:
        lbl = pad(acct["label"], 8)
        problem = problem_of(acct)
        if problem:
            out.append(f" {ink.bold(ink.blue(lbl))}{ink.red(problem[0])} {ink.dim(problem[1])}")
            continue
        rows = rows_of(acct)
        main = [r for r in rows if not r.get("extra")] or rows
        rows = main
        session = next((r for r in rows if r["group"] == "session"), None)
        weekly = next((r for r in rows if r["name"] == "주간 전체"),
                      next((r for r in rows if r["group"] == "weekly"), None))
        parts, plain = [], 1 + 8
        for tag, row in (("세션", session), ("주간", weekly)):
            if not row:
                continue
            pct, sev = row["percent"], row["severity"]
            used = "  ?" if pct is None else f"{int(pct):>3d}%"
            clock = pad(reset_text(row["resets_at"]), clock_w)
            parts.append(f"{ink.dim(tag)} {gauge(ink, pct, bar_w, sev)} {ink.by_load(pct, sev, used)} {ink.dim('↻' + clock)}")
            plain += dwidth(f"{tag} {'x' * bar_w} {used} ↻{clock}") + 2
        line = f" {ink.bold(ink.blue(lbl))}" + f"{ink.dim('│')} ".join(parts)
        email = acct.get("email") or ""
        if width >= 100 and email and plain + 1 + dwidth(email) <= width:
            line += " " + ink.dim(email)
        out.append(line)
        warning = limit_warning(acct)
        if warning:
            out.append(f"   {ink.red(warning)}")
        # 주간 전체에 여유가 있어도 Fable 등 모델별 한도는 별도로 소진될 수 있다.
        for row in rows:
            if row.get("kind") != "weekly_scoped":
                continue
            pct, sev = row["percent"], row["severity"]
            used = "  ?" if pct is None else f"{int(pct):>3d}%"
            out.append(f"   {row['name']} {gauge(ink, pct, bar_w, sev)} "
                       f"{ink.by_load(pct, sev, used)} 사용 {ink.dim('↻' + reset_text(row['resets_at']))}")
    foot = (f"{title_of(accounts)} · {fetched_text(stamp)} · `claude-usage -r` 새로고침" if width >= 72
            else f"{title_of(accounts).replace(' 사용량', '')} · {fetched_text(stamp)}")
    out.append(" " + ink.dim(foot))
    return "\n".join(out)


# ─────────────────────────────────────────── 캐시


def load_cache() -> dict | None:
    try:
        with open(CACHE_FILE) as fh:
            return json.load(fh)
    except Exception:
        return None


def _atomic_write(path: str, text: str) -> None:
    os.makedirs(CACHE_DIR, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as fh:
        fh.write(text)
    os.replace(tmp, path)


def render_path(style: str, width: int) -> str:
    return os.path.join(CACHE_DIR, f"render-{style}-{width}.txt")


def known_renders() -> set[tuple[str, int]]:
    """이미 쓰인 적 있는 (스타일, 폭) 조합 — 갱신 때 전부 다시 그려 둔다."""
    out = set()
    try:
        for name in os.listdir(CACHE_DIR):
            m = RENDER_RE.match(name)
            if m:
                out.add((m.group(1), int(m.group(2))))
    except OSError:
        pass
    return out


def write_renders(state: dict, targets: set[tuple[str, int]]) -> None:
    ink = Ink(not os.environ.get("NO_COLOR"))
    for style, width in targets:
        try:
            _atomic_write(render_path(style, width), render(state, style, ink, width) + "\n")
        except OSError:
            pass


def refresh(timeout: float, targets: set[tuple[str, int]] | None = None) -> dict:
    jobs = [("claude", label, path) for label, path in discover_accounts()]
    jobs += [("chatgpt", label, path) for label, path in discover_chatgpt_accounts()]

    def fetch(job):
        kind, label, path = job
        return fetch_chatgpt_account(label, path, timeout) if kind == "chatgpt" else fetch_account(label, path, timeout)

    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, len(jobs))) as pool:
        results = list(pool.map(fetch, jobs))
    state = {"fetched_at": time.time(), "accounts": results}
    _atomic_write(CACHE_FILE, json.dumps(state, ensure_ascii=False))
    write_renders(state, (targets or set()) | known_renders())
    return state


def spawn_refresh(style: str, width: int) -> None:
    """중복 없이 백그라운드 갱신 프로세스 하나만 띄운다."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    try:
        os.close(os.open(LOCK_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY))
    except FileExistsError:
        try:
            if time.time() - os.path.getmtime(LOCK_FILE) < 120:
                return                                   # 아직 도는 중
            os.unlink(LOCK_FILE)
        except OSError:
            return
    except OSError:
        return
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--refresh", "--quiet",
             "--style", style, "--width", str(width), "--unlock"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        try:
            os.unlink(LOCK_FILE)
        except OSError:
            pass


# ─────────────────────────────────────────── 진입점


def main() -> int:
    ap = argparse.ArgumentParser(description="Claude 다중 계정 + ChatGPT(Codex) 사용량 대시보드")
    ap.add_argument("-r", "--refresh", action="store_true", help="즉시 새로 조회(블로킹)")
    ap.add_argument("--startup", action="store_true", help="셸 시작용: 캐시 출력 + 필요하면 백그라운드 갱신")
    ap.add_argument("--style", choices=("bars", "panel", "compact"), default=DEFAULT_STYLE)
    ap.add_argument("--json", action="store_true", help="원본 상태를 JSON 으로 출력")
    ap.add_argument("--quiet", action="store_true", help="출력 없이 캐시만 갱신")
    ap.add_argument("--no-color", action="store_true")
    ap.add_argument("--width", type=int, default=0)
    ap.add_argument("--unlock", action="store_true", help=argparse.SUPPRESS)
    args = ap.parse_args()

    width = args.width or (os.get_terminal_size().columns if sys.stdout.isatty() else 100)
    target = {(args.style, width)}

    try:
        if args.refresh:
            state = refresh(TIMEOUT, target)
        else:
            state = load_cache()
            if not state:
                state = refresh(COLD_TIMEOUT, target)          # 최초 1회만 잠깐 대기
            elif time.time() - state.get("fetched_at", 0) >= TTL:
                spawn_refresh(args.style, width)               # 이번엔 캐시로, 다음부터 신선
    finally:
        if args.unlock:
            try:
                os.unlink(LOCK_FILE)
            except OSError:
                pass

    if args.quiet:
        return 0
    if args.json:
        json.dump(state, sys.stdout, ensure_ascii=False, indent=2)
        print()
        return 0
    if args.startup and time.time() - state.get("fetched_at", 0) > STALE_MAX:
        return 0                                               # 너무 낡은 정보는 보여주지 않는다

    ink = Ink(not args.no_color and not os.environ.get("NO_COLOR")
              and (sys.stdout.isatty() or os.environ.get("CLICOLOR_FORCE") == "1"))
    text = render(state, args.style, ink, width)
    if text:
        print(text)
    # 이 (스타일, 폭) 조합의 렌더 캐시가 아직 없으면 지금 남겨 둔다. 그래야 100칸이
    # 아닌 터미널에서도 두 번째 셸부터는 cat 한 번으로 끝난다.
    if args.startup and not os.path.exists(render_path(args.style, width)):
        write_renders(state, target)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
