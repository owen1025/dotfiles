#!/usr/bin/env python3
"""claude-usage — Claude Code 다중 계정 사용량/한도 대시보드.

CLAUDE_CONFIG_DIR 로 분리된 각 계정(`claude`, `claude2`, …)의 세션(5시간) 한도와
주간(7일) 한도를 Anthropic OAuth usage API 에서 읽어 요약한다.

셸 시작을 절대 막지 않는 3단 캐시:
  1. 렌더 캐시(render-<style>-<width>.txt) — zsh 가 그냥 cat 한다 (~1ms)
  2. 상태 캐시(state.json)                 — 신선도 판정용
  3. 백그라운드 갱신                        — 낡았으면 detach 해서 조용히 새로 받는다

의존성 없음(파이썬 표준 라이브러리만).
"""
from __future__ import annotations

import argparse
import concurrent.futures
import json
import os
import re
import subprocess
import sys
import time
import unicodedata
import urllib.error
import urllib.request
from datetime import datetime

API = "https://api.anthropic.com"
UA = "claude-usage/1.0 (dotfiles; local shell status)"
HOME = os.path.expanduser("~")
CACHE_DIR = os.environ.get(
    "CLAUDE_USAGE_CACHE",
    os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.join(HOME, ".cache"), "claude-usage"),
)
CACHE_FILE = os.path.join(CACHE_DIR, "state.json")
LOCK_FILE = os.path.join(CACHE_DIR, "refresh.lock")
RENDER_RE = re.compile(r"^render-(bars|panel|compact)-(\d+)\.txt$")

TTL = int(os.environ.get("CLAUDE_USAGE_TTL", "300"))                # 캐시 신선도(초)
STALE_MAX = int(os.environ.get("CLAUDE_USAGE_STALE_MAX", "86400"))  # 이보다 낡으면 아예 숨김
TIMEOUT = float(os.environ.get("CLAUDE_USAGE_TIMEOUT", "8"))
COLD_TIMEOUT = float(os.environ.get("CLAUDE_USAGE_COLD_TIMEOUT", "4"))
DEFAULT_STYLE = os.environ.get("CLAUDE_USAGE_STYLE", "bars")

# ─────────────────────────────────────────── 계정 탐색


def discover_accounts() -> list[tuple[str, str]]:
    """[(표시이름, CLAUDE_CONFIG_DIR)] 목록.

    CLAUDE_USAGE_ACCOUNTS="claude:~/.claude,claude2:~/.claude-b,claude3:~/.claude-c" 로 덮어쓸 수 있다.
    지정이 없으면 기본 두 계정 + 추가로 만든 ~/.claude-* 디렉터리(.credentials.json 있는 것만 — 즉
    로그인 전엔 안 보인다)를 자동으로 찾는다. 한 글자 접미사는 서수로(-c → claude3).
    """
    env = os.environ.get("CLAUDE_USAGE_ACCOUNTS")
    if env:
        out = []
        for chunk in env.split(","):
            chunk = chunk.strip()
            if not chunk:
                continue
            label, _, path = chunk.partition(":")
            out.append((label.strip(), os.path.expanduser(path.strip()) if path.strip()
                        else os.path.join(HOME, ".claude")))
        return out

    accounts = [("claude", os.path.join(HOME, ".claude")), ("claude2", os.path.join(HOME, ".claude-b"))]
    seen = {p for _, p in accounts}
    try:
        names = sorted(os.listdir(HOME))
    except OSError:
        names = []
    for name in names:
        if not name.startswith(".claude-"):
            continue
        path = os.path.join(HOME, name)
        if path in seen or not os.path.isfile(os.path.join(path, ".credentials.json")):
            continue
        suffix = name[len(".claude-"):]
        # ~/.claude-b → claude2, ~/.claude-c → claude3 … (셸 함수 이름과 일치); 그 외는 claude:<suffix>
        label = (f"claude{ord(suffix) - ord('a') + 1}" if len(suffix) == 1 and suffix.isalpha() and suffix.islower()
                 else f"claude:{suffix}")
        accounts.append((label, path))
    return accounts


# ─────────────────────────────────────────── API


def _creds(config_dir: str) -> dict | None:
    try:
        with open(os.path.join(config_dir, ".credentials.json")) as fh:
            return json.load(fh).get("claudeAiOauth") or None
    except Exception:
        return None


def _get(path: str, token: str, timeout: float) -> tuple[int, object]:
    req = urllib.request.Request(
        API + path,
        headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": "oauth-2025-04-20",
            "Accept": "application/json",
            "User-Agent": UA,
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, json.loads(resp.read().decode())
    except urllib.error.HTTPError as exc:
        return exc.code, None
    except Exception as exc:
        return 0, type(exc).__name__


def fetch_account(label: str, config_dir: str, timeout: float) -> dict:
    rec: dict = {"label": label, "dir": config_dir}
    oauth = _creds(config_dir)
    if not oauth:
        rec["state"] = "logged_out"
        return rec

    exp = (oauth.get("expiresAt") or 0) / 1000
    rec["token_expires_at"] = exp
    if exp and exp <= time.time():
        rec["state"] = "token_expired"
        return rec

    token = oauth.get("accessToken") or ""
    status, usage = _get("/api/oauth/usage", token, timeout)
    if status in (401, 403):
        rec["state"] = "token_expired"
        return rec
    if status != 200 or not isinstance(usage, dict):
        rec["state"] = "error"
        rec["error"] = f"HTTP {status}" if status else str(usage)
        return rec

    rec["state"] = "ok"
    rec["usage"] = usage
    status, profile = _get("/api/oauth/profile", token, timeout)
    org = {}
    if status == 200 and isinstance(profile, dict):
        rec["email"] = (profile.get("account") or {}).get("email")
        org = profile.get("organization") or {}
    rec["plan"] = plan_label(org, oauth)
    return rec


def plan_label(org: dict, oauth: dict) -> str:
    tier = (org.get("rate_limit_tier") or oauth.get("rateLimitTier") or "").strip()
    if tier.startswith("default_claude_"):
        parts = tier[len("default_claude_"):].split("_")
        return " ".join([parts[0].title()] + parts[1:])   # default_claude_max_20x → "Max 20x"
    sub = (oauth.get("subscriptionType") or org.get("organization_type") or "").replace("claude_", "")
    return sub.title() if sub else ""


# ─────────────────────────────────────────── 한도 정규화

KIND_KO = {"session": "세션", "weekly_all": "주간 전체", "weekly_scoped": "주간"}
LEGACY = (("five_hour", "세션", "session"), ("seven_day", "주간 전체", "weekly"),
          ("seven_day_opus", "주간 Opus", "weekly"), ("seven_day_sonnet", "주간 Sonnet", "weekly"))


def normalize(usage: dict) -> list[dict]:
    """API 응답을 [{name, group, percent, resets_at, severity}] 로 평탄화."""
    rows: list[dict] = []
    limits = usage.get("limits")
    if isinstance(limits, list) and limits:
        for lim in limits:
            kind = lim.get("kind") or ""
            name = KIND_KO.get(kind, kind)
            model = (((lim.get("scope") or {}).get("model") or {}).get("display_name") or "").strip()
            if kind == "weekly_scoped" and model:
                name = f"주간 {model}"
            rows.append({"name": name, "group": lim.get("group") or kind, "percent": lim.get("percent"),
                         "resets_at": lim.get("resets_at"), "severity": lim.get("severity") or "normal"})
        return rows

    for key, name, group in LEGACY:                      # 구버전 응답 폴백
        blk = usage.get(key)
        if isinstance(blk, dict) and blk.get("utilization") is not None:
            rows.append({"name": name, "group": group, "percent": blk.get("utilization"),
                         "resets_at": blk.get("resets_at"), "severity": "normal"})
    return rows


def extra_usage_line(usage: dict) -> str | None:
    """추가 사용량(크레딧)이 켜져 있을 때만 한 줄."""
    extra = usage.get("extra_usage") or {}
    if not extra.get("is_enabled"):
        return None
    used, limit = extra.get("used_credits"), extra.get("monthly_limit")
    util = extra.get("utilization")
    if used is None and util is None:
        return None
    if limit:
        return f"추가 크레딧 {used or 0}/{limit}" + (f" ({int(util)}%)" if util is not None else "")
    return f"추가 크레딧 {used or 0} 사용"


# ─────────────────────────────────────────── 폭/시간 포맷


def dwidth(text: str) -> int:
    """터미널에서 차지하는 칸 수(한글·이모지 = 2칸)."""
    total = 0
    for ch in text:
        if unicodedata.combining(ch):
            continue
        total += 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
    return total


def pad(text: str, width: int, align: str = "<") -> str:
    gap = max(0, width - dwidth(text))
    if align == ">":
        return " " * gap + text
    return text + " " * gap


def ellipsize(text: str, width: int) -> str:
    if width <= 0:
        return ""
    if dwidth(text) <= width:
        return text
    out = ""
    for ch in text:
        if dwidth(out + ch) > width - 1:
            break
        out += ch
    return out + "…"


def tilde(path: str) -> str:
    return "~" + path[len(HOME):] if path.startswith(HOME) else path


def until(iso: str | None) -> str:
    if not iso:
        return "—"
    try:
        secs = datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp() - time.time()
    except Exception:
        return "—"
    if secs <= 0:
        return "곧 초기화"
    days, rem = divmod(int(secs), 86400)
    hours, rem = divmod(rem, 3600)
    mins = rem // 60
    if days:
        return f"{days}일 {hours}시간"
    if hours:
        return f"{hours}시간 {mins}분"
    return f"{mins}분" if mins else "1분 미만"


def reset_text(iso: str | None, suffix: str = "") -> str:
    """초기화까지 남은 시간. 예약된 초기화 시각이 없으면(=세션 창이 아직 안 돌아감) 꼬리말을 뺀다."""
    if not iso:
        return "초기화 예정 없음" if suffix else "—"
    return until(iso) + suffix


def ago(ts: float) -> str:
    secs = max(0.0, time.time() - ts)
    if secs < 60:
        return "방금"
    if secs < 3600:
        return f"{int(secs // 60)}분 전"
    if secs < 86400:
        return f"{int(secs // 3600)}시간 전"
    return f"{int(secs // 86400)}일 전"


# ─────────────────────────────────────────── 색


class Ink:
    def __init__(self, enabled: bool):
        self.on = enabled

    def _w(self, code: str, text: str) -> str:
        return f"\033[{code}m{text}\033[0m" if self.on else text

    def dim(self, t):    return self._w("2", t)
    def bold(self, t):   return self._w("1", t)
    def green(self, t):  return self._w("38;5;71", t)
    def yellow(self, t): return self._w("38;5;179", t)
    def orange(self, t): return self._w("38;5;173", t)
    def red(self, t):    return self._w("38;5;167", t)
    def blue(self, t):   return self._w("38;5;110", t)
    def track(self, t):  return self._w("38;5;238", t)

    def by_load(self, pct, severity: str, text: str) -> str:
        if severity == "rejected" or (pct is not None and pct >= 100):
            return self.red(text)
        if pct is None:
            return self.dim(text)
        if pct >= 90:
            return self.red(text)
        if pct >= 75:
            return self.orange(text)
        if pct >= 50:
            return self.yellow(text)
        return self.green(text)


def gauge(ink: Ink, pct, width: int, severity: str = "normal") -> str:
    if pct is None:
        return ink.track("░" * width)
    filled = max(0, min(width, int(round(width * min(pct, 100) / 100))))
    if pct > 0 and filled == 0:
        filled = 1                       # 1% 도 눈에 보이게
    return ink.by_load(pct, severity, "█" * filled) + ink.track("░" * (width - filled))


STATE_MSG = {
    "logged_out": ("✗", "미로그인 — `{cmd}` 를 실행해 브라우저 로그인"),
    "token_expired": ("⚠", "토큰 만료 — `{cmd}` 를 한 번 실행하면 갱신됨"),
    "error": ("⚠", "조회 실패 ({err})"),
}


def problem_of(acct: dict) -> tuple[str, str] | None:
    if acct.get("state") == "ok":
        return None
    icon, msg = STATE_MSG.get(acct.get("state"), ("⚠", "알 수 없는 상태"))
    return icon, msg.format(cmd=acct.get("label", "claude"), err=acct.get("error", "?"))


# ─────────────────────────────────────────── 렌더러


def render(state: dict, style: str, ink: Ink, width: int) -> str:
    accounts = state.get("accounts") or []
    if not accounts:
        return ""
    stamp = state.get("fetched_at", time.time())
    if style == "compact":
        return render_compact(accounts, stamp, ink, width)
    if style == "panel":
        return render_panel(accounts, stamp, ink, width)
    return render_bars(accounts, stamp, ink, width)


def render_bars(accounts, stamp, ink, width) -> str:
    terse = width < 84
    bar_w = 24 if width >= 96 else (18 if width >= 84 else (12 if width >= 72 else 8))
    name_w = max((dwidth(r["name"]) for a in accounts if a.get("state") == "ok"
                  for r in normalize(a["usage"])), default=8)
    out = [f" {ink.bold('Claude 사용량')}  {ink.dim('·')}  {ink.dim(ago(stamp) + ' 갱신')}",
           " " + ink.dim("─" * max(20, min(width - 2, 74)))]
    for i, acct in enumerate(accounts):
        if i:
            out.append("")
        head = f" {ink.bold(ink.blue(pad(acct['label'], 9)))}{ink.dim(acct.get('email') or tilde(acct['dir']))}"
        if acct.get("plan"):
            head += "  " + ink.dim(f"[{acct['plan']}]")
        out.append(head)
        problem = problem_of(acct)
        if problem:
            out.append(f"   {ink.red(problem[0])} {ink.dim(problem[1])}")
            continue
        for row in normalize(acct["usage"]):
            pct, sev = row["percent"], row["severity"]
            used = "  ?" if pct is None else f"{int(pct):>3d}%"
            left = "  —" if pct is None else f"{100 - min(int(pct), 100):>3d}%"
            blown = sev == "rejected" or (pct is not None and pct >= 100)
            if terse:
                mid = f"{ink.by_load(pct, sev, used)} {ink.dim('·')} {ink.bold(left)} {ink.dim('남음')}"
                tail = f"{ink.dim('↻')} {ink.dim(reset_text(row['resets_at']))}"
            else:
                mid = (f"{ink.red('한도 초과')} {ink.dim('·')} 남음 {ink.bold(left)}" if blown
                       else f"{ink.by_load(pct, sev, used)} 사용 {ink.dim('·')} 남음 {ink.bold(left)}")
                tail = f"{ink.dim('·')} {ink.dim(reset_text(row['resets_at'], ' 후 초기화'))}"
            out.append(f"   {pad(row['name'], name_w)}  {gauge(ink, pct, bar_w, sev)}  {mid} {tail}")
        note = extra_usage_line(acct["usage"])
        if note:
            out.append(f"   {ink.dim(note)}")
    return "\n".join(out)


def render_panel(accounts, stamp, ink, width) -> str:
    inner = min(max(width - 4, 56), 78)
    bar_w = max(10, inner - 44)
    title, right = "Claude 사용량", f"{ago(stamp)} 갱신"
    fill = max(1, inner - dwidth(title) - dwidth(right) - 4)
    out = [ink.dim("╭─ ") + ink.bold(title) + " " + ink.dim("─" * fill) + " " + ink.dim(right) + ink.dim(" ─╮")]

    def line(body: str, plain: str) -> str:
        return ink.dim("│") + " " + body + " " * max(0, inner - dwidth(plain)) + ink.dim(" │")

    for i, acct in enumerate(accounts):
        if i:
            out.append(ink.dim("├" + "─" * (inner + 2) + "┤"))
        lbl = pad(acct["label"], 9)
        plan = acct.get("plan") or ""
        who = ellipsize(acct.get("email") or tilde(acct["dir"]), max(8, inner - dwidth(lbl) - dwidth(plan) - 1))
        gap = max(1, inner - dwidth(lbl + who) - dwidth(plan))
        out.append(ink.dim("│") + " " + ink.bold(ink.blue(lbl)) + ink.dim(who)
                   + " " * gap + ink.dim(plan) + ink.dim(" │"))

        problem = problem_of(acct)
        if problem:
            icon, msg = problem[0], ellipsize(problem[1], inner - 4)
            out.append(line(f"  {ink.red(icon)} {ink.dim(msg)}", f"  {icon} {msg}"))
            continue

        rows = normalize(acct["usage"])
        name_w = max((dwidth(r["name"]) for r in rows), default=8)
        for row in rows:
            pct, sev = row["percent"], row["severity"]
            used = "  ?" if pct is None else f"{int(pct):>3d}%"
            left = "  —" if pct is None else f"{100 - min(int(pct), 100):>3d}%"
            reset = reset_text(row["resets_at"])
            plain = f"  {pad(row['name'], name_w)}  {'x' * bar_w} {used} 남음 {left} ↻ {reset}"
            body = (f"  {pad(row['name'], name_w)}  {gauge(ink, pct, bar_w, sev)} "
                    f"{ink.by_load(pct, sev, used)} {ink.dim('남음')} {ink.bold(left)} {ink.dim('↻ ' + reset)}")
            out.append(line(body, plain))
        note = extra_usage_line(acct["usage"])
        if note:
            out.append(line(f"  {ink.dim(note)}", f"  {note}"))
    out.append(ink.dim("╰" + "─" * (inner + 2) + "╯"))
    return "\n".join(out)


def render_compact(accounts, stamp, ink, width) -> str:
    bar_w = 10 if width >= 100 else (8 if width >= 84 else (6 if width >= 72 else 4))
    clock_w = 10 if width >= 72 else 0
    out = []
    for acct in accounts:
        lbl = pad(acct["label"], 8)
        problem = problem_of(acct)
        if problem:
            out.append(f" {ink.bold(ink.blue(lbl))}{ink.red(problem[0])} {ink.dim(problem[1])}")
            continue
        rows = normalize(acct["usage"])
        session = next((r for r in rows if r["group"] == "session"), None)
        weekly = next((r for r in rows if r["name"] == "주간 전체"),
                      next((r for r in rows if r["group"] == "weekly"), None))
        parts, plain = [], 1 + 8
        for tag, row in (("세션", session), ("주간", weekly)):
            if not row:
                continue
            pct, sev = row["percent"], row["severity"]
            used = "  ?" if pct is None else f"{int(pct):>3d}%"
            clock = pad(reset_text(row["resets_at"]), clock_w)
            parts.append(f"{ink.dim(tag)} {gauge(ink, pct, bar_w, sev)} {ink.by_load(pct, sev, used)} {ink.dim('↻' + clock)}")
            plain += dwidth(f"{tag} {'x' * bar_w} {used} ↻{clock}") + 2
        line = f" {ink.bold(ink.blue(lbl))}" + f"{ink.dim('│')} ".join(parts)
        email = acct.get("email") or ""
        if width >= 100 and email and plain + 1 + dwidth(email) <= width:
            line += " " + ink.dim(email)
        out.append(line)
    foot = (f"Claude 사용량 · {ago(stamp)} 갱신 · `claude-usage -r` 새로고침" if width >= 72
            else f"Claude · {ago(stamp)} 갱신")
    out.append(" " + ink.dim(foot))
    return "\n".join(out)


# ─────────────────────────────────────────── 캐시


def load_cache() -> dict | None:
    try:
        with open(CACHE_FILE) as fh:
            return json.load(fh)
    except Exception:
        return None


def _atomic_write(path: str, text: str) -> None:
    os.makedirs(CACHE_DIR, exist_ok=True)
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as fh:
        fh.write(text)
    os.replace(tmp, path)


def render_path(style: str, width: int) -> str:
    return os.path.join(CACHE_DIR, f"render-{style}-{width}.txt")


def known_renders() -> set[tuple[str, int]]:
    """이미 쓰인 적 있는 (스타일, 폭) 조합 — 갱신 때 전부 다시 그려 둔다."""
    out = set()
    try:
        for name in os.listdir(CACHE_DIR):
            m = RENDER_RE.match(name)
            if m:
                out.add((m.group(1), int(m.group(2))))
    except OSError:
        pass
    return out


def write_renders(state: dict, targets: set[tuple[str, int]]) -> None:
    ink = Ink(not os.environ.get("NO_COLOR"))
    for style, width in targets:
        try:
            _atomic_write(render_path(style, width), render(state, style, ink, width) + "\n")
        except OSError:
            pass


def refresh(timeout: float, targets: set[tuple[str, int]] | None = None) -> dict:
    accounts = discover_accounts()
    with concurrent.futures.ThreadPoolExecutor(max_workers=max(1, len(accounts))) as pool:
        results = list(pool.map(lambda a: fetch_account(a[0], a[1], timeout), accounts))
    state = {"fetched_at": time.time(), "accounts": results}
    _atomic_write(CACHE_FILE, json.dumps(state, ensure_ascii=False))
    write_renders(state, (targets or set()) | known_renders())
    return state


def spawn_refresh(style: str, width: int) -> None:
    """중복 없이 백그라운드 갱신 프로세스 하나만 띄운다."""
    os.makedirs(CACHE_DIR, exist_ok=True)
    try:
        os.close(os.open(LOCK_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY))
    except FileExistsError:
        try:
            if time.time() - os.path.getmtime(LOCK_FILE) < 120:
                return                                   # 아직 도는 중
            os.unlink(LOCK_FILE)
        except OSError:
            return
    except OSError:
        return
    try:
        subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "--refresh", "--quiet",
             "--style", style, "--width", str(width), "--unlock"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:
        try:
            os.unlink(LOCK_FILE)
        except OSError:
            pass


# ─────────────────────────────────────────── 진입점


def main() -> int:
    ap = argparse.ArgumentParser(description="Claude 다중 계정 사용량 대시보드")
    ap.add_argument("-r", "--refresh", action="store_true", help="즉시 새로 조회(블로킹)")
    ap.add_argument("--startup", action="store_true", help="셸 시작용: 캐시 출력 + 필요하면 백그라운드 갱신")
    ap.add_argument("--style", choices=("bars", "panel", "compact"), default=DEFAULT_STYLE)
    ap.add_argument("--json", action="store_true", help="원본 상태를 JSON 으로 출력")
    ap.add_argument("--quiet", action="store_true", help="출력 없이 캐시만 갱신")
    ap.add_argument("--no-color", action="store_true")
    ap.add_argument("--width", type=int, default=0)
    ap.add_argument("--unlock", action="store_true", help=argparse.SUPPRESS)
    args = ap.parse_args()

    width = args.width or (os.get_terminal_size().columns if sys.stdout.isatty() else 100)
    target = {(args.style, width)}

    try:
        if args.refresh:
            state = refresh(TIMEOUT, target)
        else:
            state = load_cache()
            if not state:
                state = refresh(COLD_TIMEOUT, target)          # 최초 1회만 잠깐 대기
            elif time.time() - state.get("fetched_at", 0) >= TTL:
                spawn_refresh(args.style, width)               # 이번엔 캐시로, 다음부터 신선
    finally:
        if args.unlock:
            try:
                os.unlink(LOCK_FILE)
            except OSError:
                pass

    if args.quiet:
        return 0
    if args.json:
        json.dump(state, sys.stdout, ensure_ascii=False, indent=2)
        print()
        return 0
    if args.startup and time.time() - state.get("fetched_at", 0) > STALE_MAX:
        return 0                                               # 너무 낡은 정보는 보여주지 않는다

    ink = Ink(not args.no_color and not os.environ.get("NO_COLOR")
              and (sys.stdout.isatty() or os.environ.get("CLICOLOR_FORCE") == "1"))
    text = render(state, args.style, ink, width)
    if text:
        print(text)
    # 이 (스타일, 폭) 조합의 렌더 캐시가 아직 없으면 지금 남겨 둔다. 그래야 100칸이
    # 아닌 터미널에서도 두 번째 셸부터는 cat 한 번으로 끝난다.
    if args.startup and not os.path.exists(render_path(args.style, width)):
        write_renders(state, target)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
