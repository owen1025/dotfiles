#!/bin/sh
# tmux-osc52-copy — tmux 에서 복사한 텍스트를 OSC 52 로 "지금 붙어 있는 터미널(Ghostty)"
# 클립보드에 보낸다. tmux 서버가 원격 맥(m6)에 있어도 손앞 맥의 클립보드로 간다.
#
#   copy-command 로 불린다(`set -s copy-command tmux-osc52-copy`): 드래그·y·Enter·더블/트리플
#   클릭·C-j 가 전부 이 길 — 선택한 텍스트가 stdin 으로 온다.
#   직접도 쓴다: `echo hi | tmux-osc52-copy`, `.zshrc` 의 pbcopy alias(Linux).
#   tty 를 인자로 주면 그 tty 로만 보낸다: `tmux-osc52-copy /dev/ttys008`
#
# 왜 tmux 내장 set-clipboard 가 아니라 client tty 에 직접 쓰나:
#   tmux 내장은 OSC 52 의 선택 파라미터를 비워 `ESC ] 52 ; ; <b64>` 로 내보내는데, mosh 1.4.0 은
#   `52;c;` 로 시작하는 것만 클립보드로 받는다(terminalfunctions.cc OSC_dispatch). 그래서
#   `52;c;` 를 우리가 직접 만들어 #{client_tty} 에 쓴다. 그 tty 가 mosh-server 의 pty 라서
#   mosh → Ghostty → macOS 클립보드로 간다. 일반 ssh·로컬 Ghostty 도 똑같이 된다.
#
# "가끔 된다/안 된다" 의 원인 셋과 이 스크립트의 대응 (2026-11-23 실측):
#   1. tmux 소켓이 지워짐 — 맥 /usr/libexec/tmp_cleaner(매일 00:00)가 atime·mtime·ctime 이 모두
#      3일 넘은 /private/tmp 파일을 지운다. 서버가 오래 살아 있고 attach/detach 가 없으면 소켓
#      (/private/tmp/tmux-UID/default)이 지워져 `tmux …` 가 전부 "error connecting" — 이
#      스크립트의 list-clients·save-buffer 도 죽어 아무 데도 안 보내고 조용히 끝났다.
#      → tmux 를 부르기 전에 소켓이 없으면 서버에 SIGUSR1 을 보내 되살린다(tmux 문서의 복구법).
#        예방은 tmux-socket-guard(LaunchAgent)가 한다.
#   2. 더블/트리플클릭·C-j 는 이 스크립트를 안 거치고 tmux 버퍼에만 담겼다 → copy-command.
#   3. mosh 는 클립보드 문자열이 직전 상태와 같으면 전달하지 않는다(terminaldisplay.cc
#      `get_clipboard() != last_frame.get_clipboard()`). 같은 텍스트를 연달아 다시 복사하면
#      그 사이 맥 클립보드가 바뀌었어도 안 간다 → 같은 tty 에 같은 내용을 또 보내는 때만
#      뒤에 공백을 붙인 값을 먼저 보내 상태를 바꾸고(DECOY_WAIT 초 대기) 진짜 값을 보낸다.
#
# 기록: ~/.local/state/tmux-osc52/events.log (소켓 복구·대상 없음·쓰기 실패·재전송만 남긴다)
set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-osc52"
LOG="$STATE_DIR/events.log"
DECOY_WAIT="${TMUX_OSC52_DECOY_WAIT:-0.35}"

log() {
	mkdir -p "$STATE_DIR" 2>/dev/null || return 0
	if [ -f "$LOG" ] && [ "$(wc -c <"$LOG" 2>/dev/null || echo 0)" -gt 65536 ]; then
		tail -n 200 "$LOG" >"$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG" 2>/dev/null
	fi
	printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null || :
}

# $TMUX = <소켓 경로>,<서버 pid>,<세션 id>. 소켓 파일이 없고 서버가 살아 있으면 되살린다.
heal_socket() {
	[ -n "${TMUX:-}" ] || return 0
	sock=${TMUX%%,*}
	rest=${TMUX#*,}
	pid=${rest%%,*}
	[ -S "$sock" ] && return 0
	case $pid in '' | *[!0-9]*) return 0 ;; esac
	kill -0 "$pid" 2>/dev/null || return 0
	mkdir -p -m 700 "$(dirname "$sock")" 2>/dev/null || :
	kill -USR1 "$pid" 2>/dev/null || return 0
	i=0
	while [ ! -S "$sock" ] && [ "$i" -lt 40 ]; do
		sleep 0.05
		i=$((i + 1))
	done
	if [ -S "$sock" ]; then log "소켓 복구 $sock (서버 pid $pid)"; else log "소켓 복구 실패 $sock (서버 pid $pid)"; fi
}

tmp=$(mktemp "${TMPDIR:-/tmp}/tmux-osc52.XXXXXX") || exit 0
trap 'rm -f "$tmp"' EXIT HUP INT TERM

# 데이터: stdin(copy-command·파이프) → 비었으면 tmux 버퍼(옛 run-shell 바인딩 호환)
if [ ! -t 0 ]; then cat >"$tmp" 2>/dev/null || :; fi
if [ ! -s "$tmp" ]; then
	heal_socket
	tmux save-buffer - >"$tmp" 2>/dev/null || :
fi
# 복사할 게 없으면 클립보드를 빈 값으로 덮지 않는다.
[ -s "$tmp" ] || exit 0

buf=$(base64 <"$tmp" | tr -d '\r\n')

# 대상 tty: 인자 > tmux 클라이언트(가장 최근에 키·마우스를 쓴 것) > 컨트롤 tty
# client_activity 는 초 단위라 같은 초에 겹치면 그 둘 다에 보낸다.
if [ "$#" -gt 0 ]; then
	targets="$*"
elif [ -n "${TMUX:-}" ]; then
	heal_socket
	targets=$(tmux list-clients -F '#{client_activity} #{client_tty}' 2>/dev/null |
		sort -rn | awk 'NR==1{m=$1} $1==m{print $2}')
	[ -n "$targets" ] || log "대상 클라이언트 없음 (attach 된 클라이언트가 없거나 tmux 에 못 닿음)"
else
	targets=/dev/tty # tmux 밖(일반 ssh 셸의 pbcopy alias 등)
fi

emit() { { printf '\033]52;c;%s\007' "$1" >"$2"; } 2>/dev/null; }

sig=$(printf '%s' "$buf" | cksum | awk '{print $1 "-" $2}')
for t in $targets; do
	key=$(basename "$t")
	last=$(cat "$STATE_DIR/last-$key" 2>/dev/null || :)
	if [ "$last" = "$sig" ]; then
		decoy=$({ cat "$tmp"; printf ' '; } | base64 | tr -d '\r\n')
		emit "$decoy" "$t" && sleep "$DECOY_WAIT"
		log "같은 내용 재복사 → 상태를 바꾸려 먼저 한 번 더 보냄 ($key)"
	fi
	if emit "$buf" "$t"; then
		mkdir -p "$STATE_DIR" 2>/dev/null && printf '%s\n' "$sig" >"$STATE_DIR/last-$key" 2>/dev/null || :
	else
		log "tty 쓰기 실패 $t"
	fi
done

# 서버 맥 자신의 클립보드에도 둔다(옛 동작 유지). pbcopy 가 없는 Linux 에선 건너뛴다.
command -v pbcopy >/dev/null 2>&1 && pbcopy <"$tmp" 2>/dev/null || :
exit 0
