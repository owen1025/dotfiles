#!/usr/bin/env python3
"""macOS의 명시된 캐시만 정리한다. 기본은 미리보기, 삭제는 --apply.

상세 정책: dotfiles/docs/disk-cleanup.md. 시크릿은 저장하지 않고 Hermes CS의
slack_post.py를 호출한다. 프로세스 조회가 실패하면 삭제하지 않는다.
"""
from __future__ import annotations

import argparse
import bisect
from collections import Counter
from dataclasses import dataclass
from datetime import datetime
import fcntl
import json
import logging
from logging.handlers import RotatingFileHandler
import os
from pathlib import Path
import re
import shutil
import socket
import stat
import subprocess
import sys
import tempfile
import time
import uuid


DAY = 86400
DEFAULT_CHANNEL = "C0C4SVD21K4"  # nioh / #ops, 2026-09-29 조회 확인


@dataclass(frozen=True)
class Rule:
    name: str
    root: Path
    days: int
    mode: str = "files"
    apps: tuple = ()
    current: Path | None = None


def canonical(path):
    return os.path.realpath(path)


class Processes:
    def __init__(self, commands, opened):
        self.commands = commands
        self.opened = {canonical(p) for p in opened}
        self.sorted_opened = sorted(self.opened)
        self.watch = False
        self.checked_at = time.monotonic()
        self.inodes = set()
        for path in self.opened:
            try:
                s = os.stat(path)
                self.inodes.add((s.st_dev, s.st_ino))
            except OSError:
                pass

    @classmethod
    def capture(cls):
        ps = subprocess.run(["/bin/ps", "-axww", "-o", "command="],
                            capture_output=True, text=True, timeout=30)
        ls = subprocess.run(["/usr/sbin/lsof", "-nP", "-Fpn"],
                            capture_output=True, text=True, timeout=60)
        if ps.returncode or ls.returncode or not ps.stdout.strip() or not ls.stdout.strip():
            raise RuntimeError("프로세스/열린 파일 조회 실패 — 삭제 중단")
        opened = [line[1:] for line in ls.stdout.splitlines() if line.startswith("n/")]
        result = cls(ps.stdout, opened)
        result.watch = True
        return result

    def refresh(self):
        if self.watch and time.monotonic() - self.checked_at > 30:
            self.__dict__.update(self.capture().__dict__)

    def busy(self, path):
        key = str(path)
        aliases = [key]
        if key.startswith("/private/"):
            aliases.append(key[len("/private"):])
        index = bisect.bisect_left(self.sorted_opened, key + "/")
        descendant = (index < len(self.sorted_opened)
                      and self.sorted_opened[index].startswith(key + "/"))
        return any(value in self.commands for value in aliases) or key in self.opened or descendant

    def app_running(self, names):
        return any(name in self.commands for name in names)


def rules(home, temp):
    capcut = home / "Movies/CapCut/User Data"
    support = home / "Library/Application Support"
    slack = home / "Library/Containers/com.tinyspeck.slackmacgap/Data/Library/Application Support/Slack"
    result = [
        Rule("CapCut 캐시", capcut / "Cache", 3, apps=("/Applications/CapCut.app/",)),
        Rule("npm 캐시", home / ".npm/_cacache", 3),
        Rule("npx 패키지", home / ".npm/_npx", 7, "children"),
        Rule("Chrome 캐시", home / "Library/Caches/Google", 3,
             apps=("/Applications/Google Chrome.app/", "chrome-headless-shell")),
        Rule("Slack 캐시", slack / "Cache", 3, apps=("/Slack.app/",)),
        Rule("Slack 서비스워커 캐시", slack / "Service Worker/CacheStorage", 3,
             apps=("/Slack.app/",)),
        Rule("Claude 웹 캐시", support / "Claude/Cache", 3, apps=("/Applications/Claude.app/",)),
        Rule("Claude 코드 캐시", support / "Claude/Code Cache", 3, apps=("/Applications/Claude.app/",)),
        Rule("CapCut 설치 파일", capcut / "Download", 3, apps=("/Applications/CapCut.app/",)),
        Rule("Bitwarden 설치 캐시", home / "Library/Caches/bitwarden-updater", 3,
             apps=("/Bitwarden.app/",)),
        Rule("Vrew 설치 캐시", support / "Caches/vrew-updater/pending", 3, apps=("/Vrew.app/",)),
        Rule("Google 설치 캐시", support / "Google/GoogleUpdater/crx_cache", 3),
        Rule("Logi 캐시", Path("/Library/Application Support/Logi/LogiOptionsPlus/cache"), 3),
        Rule("개발 배포 캐시", home / ".cache/lazyowen-web-deploy", 7, "whole"),
        Rule("개발 검증 캐시", home / ".cache", 7, "validation"),
        Rule("임시 빌드", Path("/private/tmp/studio-sandbox/app/.next"), 7, "whole"),
        Rule("Claude 임시 작업", Path(f"/private/tmp/claude-{os.getuid()}"), 7, "sessions"),
        Rule("Claude VM 번들", support / "Claude/vm_bundles", 14, "children",
             ("/Applications/Claude.app/", "com.anthropic.claude", "Virtualization.VirtualMachine")),
        Rule("Claude 구버전", home / ".local/share/claude/versions", 7, "versions",
             current=home / ".local/bin/claude"),
        Rule("Codex CLI 구버전", home / ".codex/packages/standalone/releases", 7, "versions",
             current=home / ".codex/packages/standalone/current"),
        Rule("Codex 데몬 구버전", home / ".codex/packages/app-server-daemon/releases", 7, "versions",
             current=home / ".codex/packages/app-server-daemon/current"),
        Rule("휴지통", home / ".Trash", 30, "trash"),
    ]
    if temp:
        result.append(Rule("Finder 임시 영상", temp / "TemporaryItems", 7, "videos"))
    return result


def checked_path(path):
    """조상 symlink까지 거부한다. 이동된 캐시가 외장/원본을 가리키면 건드리지 않는다."""
    return str(path) == canonical(path) and not path.is_symlink()


def candidates(rule):
    root = rule.root
    if not root.exists():
        return
    if not checked_path(root):
        raise ValueError("심링크 경로 보존")
    if rule.mode == "whole":
        yield root
    elif rule.mode in ("children", "trash", "versions", "validation"):
        if rule.mode == "versions":
            if not rule.current.is_symlink() or not rule.current.exists():
                raise ValueError("현재 버전 링크 확인 불가")
            current = rule.current.resolve()
            if current.parent != root:
                raise ValueError("현재 버전이 releases/versions 밖에 있음")
        for path in root.iterdir():
            if rule.mode == "validation" and not re.fullmatch(r"studio-publish-validation-\d{8}", path.name):
                continue
            if rule.mode == "versions":
                if path == current or not re.fullmatch(r"\d+\.\d+\.\d+(?:-(?:aarch64|x86_64)-apple-darwin)?", path.name):
                    continue
            yield path
    elif rule.mode == "sessions":
        for project in root.iterdir():
            if project.is_dir() and not project.is_symlink() and project.name.startswith("-Users-"):
                for session in project.iterdir():
                    if re.fullmatch(r"[0-9a-fA-F-]{36}", session.name):
                        yield session
            elif project.name == "bash-edit-diff":
                yield project
    else:
        def fail(error):
            raise error
        for directory, dirs, files in os.walk(root, followlinks=False, onerror=fail):
            dirs[:] = [name for name in dirs if not (Path(directory) / name).is_symlink()]
            for name in files:
                path = Path(directory) / name
                if rule.mode == "videos" and path.suffix.lower() not in (".mp4", ".mov", ".m4v", ".avi", ".mkv"):
                    continue
                yield path


def inspect(path, processes):
    """하위 전체를 확인한다. 오래된 부모 아래의 새 파일·열린 hardlink도 보호한다."""
    if not checked_path(path):
        raise ValueError("심링크 경로 보존")
    if processes.busy(path):
        raise ValueError("사용 중")
    first = path.lstat()
    device = first.st_dev
    newest = 0
    size = 0
    seen = set()
    stack = [path]
    while stack:
        item = stack.pop()
        s = item.lstat()
        if stat.S_ISLNK(s.st_mode):
            # 내부 링크는 삭제될 때 링크만 제거되고 대상은 추적하지 않는다.
            newest = max(newest, s.st_mtime, s.st_ctime)
            continue
        if s.st_dev != device:
            raise ValueError("다른 파일시스템 보존")
        if (s.st_dev, s.st_ino) in processes.inodes:
            raise ValueError("열린 파일/하드링크 보존")
        if not (stat.S_ISDIR(s.st_mode) or stat.S_ISREG(s.st_mode)):
            raise ValueError("소켓·특수 파일 보존")
        newest = max(newest, s.st_mtime, s.st_ctime)
        if (s.st_dev, s.st_ino) not in seen:
            size += s.st_blocks * 512
            seen.add((s.st_dev, s.st_ino))
        if stat.S_ISDIR(s.st_mode):
            stack.extend(item.iterdir())
    return size, newest, (first.st_dev, first.st_ino)


def fingerprint(path):
    s = path.lstat()
    return f"{s.st_dev}:{s.st_ino}:{path.name}"


def remove(path, identity):
    # 직전 identity와 조상 경로를 재확인하고 symlink 교체 경쟁을 거부한다.
    if not checked_path(path):
        raise ValueError("삭제 직전 경로 변경")
    s = path.lstat()
    if (s.st_dev, s.st_ino) != identity:
        raise ValueError("삭제 직전 파일 교체")
    if path.is_dir():
        if not shutil.rmtree.avoids_symlink_attacks:
            raise RuntimeError("안전한 디렉터리 삭제 API 없음")
        shutil.rmtree(path)
    else:
        path.unlink()


def clean(rule_list, processes, now, apply=False, trash_seen=None):
    trash_seen = {} if trash_seen is None else trash_seen
    current_trash = {}
    report = {"groups": {}, "samples": [], "errors": [], "candidate_bytes": 0, "removed_bytes": 0}
    for rule in rule_list:
        group = report["groups"].setdefault(rule.name, {"removed": 0, "bytes": 0, "eligible": 0, "kept": Counter()})
        if processes.app_running(rule.apps):
            group["kept"]["앱 실행 중"] += 1
            continue
        try:
            for path in candidates(rule):
                try:
                    observed = None
                    if rule.mode == "trash":
                        key = fingerprint(path)
                        observed = trash_seen.get(key, now)
                        current_trash[key] = observed
                    size, newest, identity = inspect(path, processes)
                    if rule.name == "Claude VM 번들":
                        # 읽기 전용 이미지 사용도 반영하되 스캔으로 변하는 디렉터리 atime은 제외.
                        for image in path.glob("*.img*"):
                            newest = max(newest, image.stat().st_atime)
                    if observed is not None:
                        newest = max(newest, observed)
                    if newest > now - rule.days * DAY:
                        group["kept"]["보존 기간 이내"] += 1
                        continue
                    if not os.access(path.parent, os.W_OK):
                        group["kept"]["관리자 권한 필요"] += 1
                        continue
                    group["eligible"] += 1
                    report["candidate_bytes"] += size
                    if len(report["samples"]) < 20:
                        report["samples"].append({"group": rule.name, "path": str(path), "bytes": size})
                    if apply:
                        processes.refresh()
                        if processes.app_running(rule.apps):
                            group["kept"]["앱 실행 중"] += 1
                            continue
                        # 시간이 긴 스캔 뒤 mtime/ctime·열린 inode를 다시 검사한다.
                        _, latest, latest_identity = inspect(path, processes)
                        if latest > now - rule.days * DAY or latest_identity != identity:
                            group["kept"]["삭제 전 변경 감지"] += 1
                            continue
                        remove(path, identity)
                        group["removed"] += 1
                        group["bytes"] += size
                        report["removed_bytes"] += size
                        if rule.mode == "trash":
                            current_trash.pop(key, None)
                except (OSError, ValueError) as error:
                    reason = str(error) if isinstance(error, ValueError) else type(error).__name__
                    group["kept"][reason] += 1
                    if isinstance(error, OSError) and len(report["errors"]) < 20:
                        report["errors"].append(f"{rule.name}: {type(error).__name__}")
        except (OSError, ValueError) as error:
            group["kept"][str(error) if isinstance(error, ValueError) else type(error).__name__] += 1
            if isinstance(error, OSError) and len(report["errors"]) < 20:
                report["errors"].append(f"{rule.name}: {type(error).__name__}")
        except RuntimeError as error:
            report["fatal"] = str(error)
            break
    return report, current_trash


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return default


def write_json(path, data):
    fd, temp = tempfile.mkstemp(prefix=".write-", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            json.dump(data, handle, ensure_ascii=False, indent=2)
            handle.write("\n")
        os.replace(temp, path)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def notification(report):
    def gib(value):
        return f"{value / 1024**3:.2f}GiB"
    title = "디스크 자동 청소 완료" if not report.get("fatal") else "디스크 자동 청소 중단"
    if report.get("errors") and not report.get("fatal"):
        title = "디스크 자동 청소 일부 완료"
    lines = [f"[{title}] {socket.gethostname()}",
             f"시각: {report['finished']}",
             f"여유 공간: {gib(report['free_before'])} → {gib(report['free_after'])}",
             f"여유 변화: {(report['free_after'] - report['free_before']) / 1024**3:+.2f}GiB",
             f"삭제 파일·폴더: {sum(g['removed'] for g in report['groups'].values())}개 · 표시 용량 {gib(report['removed_bytes'])}"]
    for name, group in report["groups"].items():
        if group["removed"]:
            lines.append(f"• {name}: {gib(group['bytes'])}")
    kept = Counter()
    for group in report["groups"].values():
        kept.update(group["kept"])
    if kept:
        lines.append("보존: " + ", ".join(f"{k} {v}건" for k, v in kept.items()))
    if report.get("errors") or report.get("fatal"):
        lines.append("확인 필요: " + "; ".join([report.get("fatal", "")] + report["errors"]).strip("; "))
    lines.append("매일 04:30(맥 현지 시각) · 원본/프로젝트/대화/DB 제외")
    if report["free_after"] < 10 * 1024**3:
        lines.append("⚠ 여유 공간 10GiB 미만 — 보존 자료의 아카이브 검토 필요")
    return "\n".join(lines)


def deliver(home, state, config, report, logger):
    """네트워크 실패 시 다음 실행에 재시도. delivery id는 재시도마다 동일하다."""
    path = state / "pending-slack.json"
    queue = read_json(path, [])
    queue.append({"id": report["id"], "text": notification(report)})
    if len(queue) > 30:
        queue = queue[-30:]
        queue[-1]["text"] += "\n⚠ Slack 전송 실패가 30회 넘게 누적돼 오래된 대기 알림을 정리했습니다."
    write_json(path, queue)
    helper = home / ".hermes/profiles/cs/scripts/slack_post.py"
    for item in list(queue):
        try:
            result = subprocess.run(
                [sys.executable, str(helper), "--channel", config["slack_channel"],
                 "--stdin", "--client-msg-id", "disk-cleanup:" + item["id"]],
                input=item["text"], capture_output=True, text=True, timeout=45)
        except (OSError, subprocess.TimeoutExpired) as error:
            logger.error("Slack 알림 보류: %s", type(error).__name__)
            return "대기"
        if result.returncode or not result.stdout.startswith(("ok ", "deferred ")):
            logger.error("Slack 알림 보류: %s", (result.stderr or result.stdout).strip()[:300])
            return "대기"
        logger.info("Slack: %s", result.stdout.strip())
        queue.pop(0)
        write_json(path, queue)
    return "전달 완료"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--apply", action="store_true", help="실제로 삭제")
    mode.add_argument("--dry-run", action="store_true", help="미리보기(기본)")
    parser.add_argument("--notify", action="store_true", help="실행 결과를 Slack #ops로 알림")
    args = parser.parse_args()
    if sys.platform != "darwin":
        parser.error("macOS 전용 청소 작업입니다")
    if args.notify and not args.apply:
        parser.error("--notify는 --apply와 함께 사용합니다")
    os.umask(0o077)
    home = Path.home().resolve()
    state = home / ".local/state/disk-cleanup"
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    logger = logging.getLogger("disk-cleanup")
    logger.setLevel(logging.INFO)
    handler = RotatingFileHandler(state / "cleanup.log", maxBytes=1024**2, backupCount=3)
    handler.setFormatter(logging.Formatter("%(asctime)s %(levelname)s %(message)s"))
    logger.addHandler(handler)
    with (state / "run.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("disk-cleanup: 이미 실행 중")
            return 0
        config = read_json(home / ".config/disk-cleanup/config.json", {"slack_channel": DEFAULT_CHANNEL})
        if not re.fullmatch(r"[CG][A-Z0-9]+", config.get("slack_channel", "")):
            raise ValueError("Slack 채널 ID 설정 오류")
        start = time.time()
        report = {"id": str(uuid.uuid4()), "free_before": shutil.disk_usage(home).free,
                  "groups": {}, "removed_bytes": 0, "errors": [], "dry_run": not args.apply}
        try:
            process = Processes.capture()
            raw_temp = subprocess.check_output(["/usr/bin/getconf", "DARWIN_USER_TEMP_DIR"], text=True).strip()
            temp = Path(raw_temp).resolve()
            if not str(temp).startswith("/private/var/folders/") or temp.name != "T":
                raise RuntimeError("macOS 임시 경로 확인 실패")
            seen = read_json(state / "trash-seen.json", {})
            result, seen = clean(rules(home, temp), process, start, args.apply, seen)
            report.update(result)
            if args.apply:
                write_json(state / "trash-seen.json", seen)
        except Exception as error:
            report["fatal"] = f"{type(error).__name__}: {error}"
            logger.exception("청소 중단")
        report.update(finished=datetime.now().astimezone().isoformat(timespec="seconds"),
                      free_after=shutil.disk_usage(home).free, duration_seconds=round(time.time() - start, 1))
        if args.apply:
            write_json(state / "last-run.json", report)
            if args.notify:
                report["slack"] = deliver(home, state, config, report, logger)
                write_json(state / "last-run.json", report)
            logger.info("완료: removed_bytes=%s free=%s duration=%ss fatal=%s",
                        report["removed_bytes"], report["free_after"], report["duration_seconds"], report.get("fatal", ""))
        print(json.dumps(report, ensure_ascii=False, indent=2))
        return 1 if report.get("fatal") or report.get("errors") or report.get("slack") == "대기" else 0


if __name__ == "__main__":
    sys.exit(main())
