#!/usr/bin/env bash
# tmux-socket-guard — 살아 있는 tmux 서버의 소켓 파일이 /tmp 청소에 지워지지 않게 지키고,
# 이미 지워졌으면 되살린다.
#
# 왜 필요한가 (2026-11-23 실측):
#   macOS 의 /usr/libexec/tmp_cleaner(com.apple.tmp_cleaner, 매일 00:00)는 /private/tmp 에서
#   atime·mtime·ctime 이 "모두" 3일 넘은 파일을 지운다. tmux 소켓(/private/tmp/tmux-UID/default)은
#   connect() 로는 atime 이 안 바뀌고(실측), 서버가 chmod 하는 건 attached 세션 수가 0↔1 로
#   바뀔 때뿐이라 — 같은 클라이언트가 3일 넘게 붙어 있는 서버는 소켓이 지워진다. 서버는 멀쩡히
#   살아 있고 이미 붙은 화면도 그대로지만 새로 부르는 `tmux …`(list-clients·save-buffer·attach)
#   는 전부 "error connecting to … (No such file or directory)" — 복사 스크립트가 조용히 죽고,
#   새 셸에서 `tmux new -s m4` 를 치면 같은 이름의 서버가 하나 더 생긴다.
#   (m6 에서 tmux 서버가 7일째 살아 있는데 소켓이 없었다 — kill -USR1 로 되살림.)
#
# 하는 일 (tmux 서버마다):
#   - 소켓이 있다 → touch 로 atime·mtime·ctime 을 새로 찍어 청소 기한을 미룬다.
#   - 소켓이 없다 → 디렉토리를 만들고 서버에 SIGUSR1 (tmux 문서: "소켓을 실수로 지웠으면
#     SIGUSR1 로 다시 만들 수 있다"). 세션·창·프로그램은 그대로다.
#   서버가 아닌 tmux(클라이언트)에는 절대 신호를 보내지 않는다 — 클라이언트는 SIGUSR1 에
#   죽는다. 서버 판별: 제어 tty 가 없고(`??`) 이름 붙은 unix 소켓을 직접 bind 하고 있다
#   (lsof 가 경로를 보여 준다 — 클라이언트는 `->0x…` 만 보인다).
#   경로가 다른 서버가 새로 차지했으면(파일이 있으면) 건드리지 않는다 — 덮어쓰면 새 서버를 잃는다.
#
#   tmux-socket-guard          점검하고 필요하면 고친다. 고친 것만 한 줄씩 출력
#   tmux-socket-guard -n       고치지 않고 상태만 출력 (dry-run)
#   tmux-socket-guard --check  상태 출력, 소켓이 없는 서버가 있으면 종료 코드 1
#
# 스케줄: launchd com.owen.tmux-socket-guard (1시간마다, ~/Library/LaunchAgents) — macOS 전용.
# Ubuntu 는 /tmp 를 나이로 지우지 않는다(systemd tmpfiles 기본). 로그: ~/Library/Logs/tmux-socket-guard.log
set -uo pipefail

MODE=fix
case "${1:-}" in
	-n | --dry-run) MODE=dry ;;
	--check) MODE=check ;;
	"") ;;
	-h | --help)
		sed -n '2,32p' "$0" | sed 's/^# \{0,1\}//'
		exit 0
		;;
	*)
		echo "usage: tmux-socket-guard [-n|--check]" >&2
		exit 2
		;;
esac

uid=$(id -u)
bad=0
seen=0

# 제어 tty 가 없는 tmux 프로세스 = 서버 후보 (macOS `??`, Linux `?`)
while read -r pid tty comm; do
	[[ ${comm##*/} == tmux ]] || continue
	[[ $tty == '??' || $tty == '?' ]] || continue
	# 서버가 bind 한 소켓 경로. 클라이언트·소켓이 없는 프로세스는 비어 있다.
	paths=$(lsof -nP -a -p "$pid" -U -Fn 2>/dev/null | sed -n 's/^n\(\/.*\)$/\1/p' | sort -u)
	[[ -n $paths ]] || continue
	seen=$((seen + 1))
	while read -r path; do
		[[ -n $path ]] || continue
		# 테스트용: 이 디렉토리 아래 소켓만 본다(진짜 서버를 건드리지 않게)
		[[ -z ${TMUX_SOCKET_GUARD_DIR:-} || $path == "$TMUX_SOCKET_GUARD_DIR"/* ]] || continue
		if [[ -S $path ]]; then
			[[ $MODE == fix ]] && touch "$path" 2>/dev/null
			[[ $MODE == fix ]] || echo "ok   서버 $pid $path"
			continue
		fi
		bad=$((bad + 1))
		case $MODE in
		check | dry) echo "소켓 없음 — 서버 $pid $path" ;;
		fix)
			dir=$(dirname "$path")
			mkdir -p -m 700 "$dir" 2>/dev/null
			if kill -USR1 "$pid" 2>/dev/null; then
				for _ in $(seq 1 40); do
					[[ -S $path ]] && break
					sleep 0.05
				done
				if [[ -S $path ]]; then
					echo "$(date '+%F %T') 소켓 복구: 서버 $pid $path"
				else
					echo "$(date '+%F %T') 소켓 복구 실패: 서버 $pid $path" >&2
				fi
			fi
			;;
		esac
	done <<<"$paths"
done < <(ps -U "$uid" -o pid=,tty=,comm=)

[[ $MODE == check ]] && echo "tmux 서버 $seen 개, 소켓 없는 것 $bad 개"
[[ $MODE == check && $bad -gt 0 ]] && exit 1
exit 0
