#!/usr/bin/env python3
"""이 Mac mini의 SSH·PF 정책에 내부망 SSH와 화면 공유 접속을 추가한다."""

import argparse
import datetime
import os
from pathlib import Path
import platform
import shutil
import subprocess
import tempfile


CONFIG = Path("/etc/ssh/sshd_config.d/040-lazyowen-tailscale-only.conf")
TAILNET = {"owen@100.64.0.0/10", "owen@fd7a:115c:a1e0::/48"}
LAN = "owen@192.168.219.0/24"
SSHD = "/usr/sbin/sshd"
PF_CONFIG = Path("/Library/Application Support/lazyowen/pf-tailscale-only.conf")
PF_ANCHOR = "com.apple/990.lazyowen"
PFCTL = "/sbin/pfctl"
PF_LAN_RULES = (
    "pass in quick on { en0 en1 } inet proto tcp from 192.168.219.0/24 to any port { 22 5900 } no state\n"
    "pass in quick on { en0 en1 } inet proto udp from 192.168.219.0/24 to any port { 5900 5901 5902 } no state\n"
)


def updated_config(original):
    lines = original.splitlines(keepends=True)
    matches = [i for i, line in enumerate(lines)
               if line.split() and line.split()[0].lower() == "allowusers"]
    if len(matches) != 1:
        raise ValueError("AllowUsers가 정확히 한 줄인 기존 설정만 수정합니다.")
    index = matches[0]
    users = set(lines[index].split()[1:])
    if users not in (TAILNET, TAILNET | {LAN}):
        raise ValueError("예상과 다른 SSH 허용 목록입니다. 기존 설정을 검토하세요.")
    if users == TAILNET | {LAN}:
        return original
    lines[index] = lines[index].rstrip("\r\n") + " " + LAN + "\n"
    lines.insert(index, "# 2026-10-19 Owen 요청: 기존 공개키 인증 유지, 내부망 192.168.219.0/24 추가.\n")
    return "".join(lines)


def updated_pf(original):
    expected = [
        'login_ports = "{ 22 88 3283 5900 }"',
        'pass in quick on lo0 all no state',
        'pass in quick inet proto { tcp udp } from 100.64.0.0/10 to any port $login_ports no state',
        'pass in quick inet6 proto { tcp udp } from fd7a:115c:a1e0::/48 to any port $login_ports no state',
        'block drop in quick proto { tcp udp } to any port $login_ports',
    ]
    clean = lambda text: [" ".join(line.split()) for line in text.splitlines()
                          if line.strip() and not line.lstrip().startswith("#")]
    actual = clean(original)
    if actual == expected[:-1] + clean(PF_LAN_RULES) + expected[-1:]:
        return original
    if actual != expected:
        raise ValueError("예상과 다른 PF 규칙입니다. 기존 방화벽을 덮지 않습니다.")
    return original.replace(expected[-1],
                            "# 2026-10-19 Owen: 내부망 SSH·화면 공유 허용, 외부 차단 유지\n"
                            + PF_LAN_RULES + expected[-1])


def apply_ssh(original, updated):
    if original == updated:
        print("SSH 내부망 허용: 이미 적용됨")
        return
    # 검증 실패 시 원래 파일로 복원한다. 백업·임시 파일은 Include 대상 밖에 둔다.
    subprocess.run([SSHD, "-t"], check=True)
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    backup = CONFIG.parent.parent / f"{CONFIG.name}.backup-{stamp}"
    with tempfile.TemporaryDirectory(prefix=".lan-ssh-", dir=CONFIG.parent.parent) as tmp:
        candidate = Path(tmp) / CONFIG.name
        candidate.write_text(updated)
        os.chmod(candidate, 0o644)
        subprocess.run([SSHD, "-t", "-f", str(candidate)], check=True)
        shutil.copy2(CONFIG, backup)
        os.chmod(backup, 0o600)
        os.replace(candidate, CONFIG)
        try:
            subprocess.run([SSHD, "-t"], check=True)
            result = subprocess.run([SSHD, "-T"], check=True, text=True, capture_output=True)
            effective = dict(line.split(" ", 1) for line in result.stdout.splitlines())
            required = {"passwordauthentication": "no", "kbdinteractiveauthentication": "no",
                        "permitrootlogin": "no", "authenticationmethods": "publickey"}
            if any(effective.get(key) != value for key, value in required.items()):
                raise ValueError("기존 공개키 전용 인증 정책 검증 실패")
            allowed = [line.split(" ", 1)[1] for line in result.stdout.splitlines()
                       if line.startswith("allowusers ")]
            if set(" ".join(allowed).split()) != TAILNET | {LAN}:
                raise ValueError("실제 SSH 허용 목록 검증 실패")
        except Exception:
            shutil.copy2(backup, candidate)
            os.chmod(candidate, 0o644)
            os.replace(candidate, CONFIG)
            raise
    print(f"SSH 적용 완료. 백업: {backup}")


def apply_pf(original, updated):
    # 전체 PF를 끄거나 재로드하지 않고, 기존 사용자 앵커만 갱신한다.
    live = subprocess.run([PFCTL, "-a", PF_ANCHOR, "-s", "rules"],
                          check=True, text=True, capture_output=True).stdout
    if not live.strip():
        raise ValueError("기존 PF 앵커가 비어 있습니다. 다른 차단 원인을 확인하세요.")
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S-%f")
    backup = PF_CONFIG.with_name(PF_CONFIG.name + ".backup-" + stamp)
    live_backup = PF_CONFIG.with_name("pf-live.backup-" + stamp)
    with tempfile.TemporaryDirectory(prefix=".lan-pf-", dir=PF_CONFIG.parent) as tmp:
        candidate = Path(tmp) / "rules.conf"
        candidate.write_text(updated)
        os.chmod(candidate, 0o644)
        subprocess.run([PFCTL, "-n", "-a", PF_ANCHOR, "-f", str(candidate)], check=True)
        shutil.copy2(PF_CONFIG, backup)
        os.chmod(backup, 0o600)
        live_backup.write_text(live)
        os.chmod(live_backup, 0o600)
        os.replace(candidate, PF_CONFIG)
        try:
            subprocess.run([PFCTL, "-q", "-a", PF_ANCHOR, "-f", str(PF_CONFIG)], check=True)
            rules = subprocess.run([PFCTL, "-a", PF_ANCHOR, "-s", "rules"],
                                   check=True, text=True, capture_output=True).stdout
            if "from 192.168.219.0/24" not in rules or "block drop in quick" not in rules:
                raise ValueError("PF 내부망 허용·기존 외부 차단 검증 실패")
        except Exception:
            shutil.copy2(backup, candidate)
            os.chmod(candidate, 0o644)
            os.replace(candidate, PF_CONFIG)
            subprocess.run([PFCTL, "-q", "-a", PF_ANCHOR, "-f", str(live_backup)], check=True)
            raise
    print(f"PF 적용 완료. 파일 백업: {backup}")
    print(f"직전 실행 규칙 백업: {live_backup}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--apply", action="store_true", help="관리자 권한으로 적용 (기본: 미리보기)")
    args = parser.parse_args()
    if platform.system() != "Darwin":
        parser.error("macOS 전용입니다.")
    for path in (CONFIG, PF_CONFIG):
        if path.is_symlink() or not path.is_file():
            parser.error(f"기존 일반 파일이 필요합니다: {path}")
    original, pf_original = CONFIG.read_text(), PF_CONFIG.read_text()
    updated, pf_updated = updated_config(original), updated_pf(pf_original)
    if not args.apply:
        import difflib
        for path, before, after in ((CONFIG, original, updated), (PF_CONFIG, pf_original, pf_updated)):
            if before == after:
                print(f"파일에 내부망 허용 있음: {path}")
            else:
                print("".join(difflib.unified_diff(before.splitlines(True), after.splitlines(True),
                                                 fromfile=str(path), tofile=str(path))), end="")
        print("PF 실행 중 규칙 확인·적용에는 관리자 인증이 필요합니다.")
        print("적용: sudo ~/.local/bin/mac-lan-ssh --apply")
        return
    if os.geteuid() != 0:
        parser.error("관리자 인증이 필요합니다: sudo ~/.local/bin/mac-lan-ssh --apply")
    apply_ssh(original, updated)
    apply_pf(pf_original, pf_updated)
    print("내부망 SSH·화면 공유 허용 완료. 기존 Tailscale·공개키 인증·외부 차단 유지.")
    print("다른 기기에서 실제 접속을 확인하세요. 실행 중인 세션은 유지됩니다.")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        raise SystemExit(f"적용 실패: {error}")
