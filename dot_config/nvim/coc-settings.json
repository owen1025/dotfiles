{
    "languageserver": {
      "bash": {
        "command": "bash-language-server",
        "args": ["start"],
        "filetypes": ["sh"],
        "ignoredRootPaths": ["~"]
      },
      "dockerfile": {
        "command": "docker-langserver",
        "filetypes": ["dockerfile"],
        "args": ["--stdio"]
      },
      "terraform": {
        "command": "terraform-ls",
        "args": ["serve"],
        "filetypes": [
            "terraform",
            "terraform-vars"
        ],
        "initializationOptions": {},
        "settings": {}
      }
    },
    "yaml.schemas": {
      "kubernetes": [
        "/k8s/*.yaml",
        "/kubernetes/*.yaml",
        "/manifests/*.yaml",
        "*.k8s.yaml"
      ]
    },
    "go.checkForUpdates": "disabled",
    "json.schemaDownload.trustedDomains": {
      "https://www.schemastore.org": true,
      "https://json.schemastore.org": true,
      "https://opencode.ai": true,
      "https://hyperframes.heygen.com": true
    }
}
